<Window x:Class="MemPilot.App.ThreadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Thread_Title}" Width="760" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Common_Refresh}" Click="Refresh_Click" Style="{StaticResource ToolBtn}"/>
            </StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
        </DockPanel>
        <DataGrid Grid.Row="1" x:Name="ThreadGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Thread_Suspend}" Click="Suspend_Click"/>
                    <MenuItem Header="{DynamicResource Thread_Resume}" Click="Resume_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource Col_State}" Binding="{Binding State}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource Col_WaitReason}" Binding="{Binding WaitReason}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource Col_Priority}" Binding="{Binding Priority}" Width="70"/>
                <DataGridTextColumn Header="{DynamicResource Col_CpuTime}" Binding="{Binding TotalCpuTime}" Width="110"/>
                <DataGridTextColumn Header="{DynamicResource Col_StartTime}" Binding="{Binding StartTime}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
