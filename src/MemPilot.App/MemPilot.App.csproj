<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MemPilot</AssemblyName>
    <RootNamespace>MemPilot</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.14.0</Version>
    <AssemblyVersion>0.14.0.0</AssemblyVersion>
    <FileVersion>0.14.0.0</FileVersion>
    <!-- 可复现构建：锁文件入库，CI 用 locked-mode（棱镜 stack/dependency） -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Title>MemPilot</Title>
    <Product>MemPilot - 内存领航员</Product>
    <Description>MemPilot：常驻内存与进程领航员——未使用检测、场景模式、腾挪工作流</Description>
    <Company>MemPilot</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <!-- 公共 using 收敛（v0.3.8，棱镜 maintainability/usings-duplication）：
       6 个 MainWindow partial 原先各自复制 17 行 using，重复率第一来源就是它们。 -->
  <ItemGroup>
    <Using Include="System.ComponentModel" />
    <Using Include="System.Windows" />
    <Using Include="System.Windows.Controls" />
    <Using Include="System.Windows.Media" />
    <Using Include="MemPilot.Helpers" />
    <Using Include="MemPilot.Models" />
    <Using Include="MemPilot.Services" />
    <Using Include="MemPilot.ViewModels" />
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.Controls.TabControl" Alias="TabControl" />
    <Using Include="System.Windows.Controls.RadioButton" Alias="RadioButton" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
    <Using Include="System.Windows.Media.Colors" Alias="Colors" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MemPilot.Core\MemPilot.Core.csproj" />
  </ItemGroup>
  <Target Name="SignExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <!-- sign both the apphost exe (what users double-click, SmartScreen checks it) and the managed dll -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\sign.ps1&quot; -TargetPath &quot;$(TargetDir)$(TargetName).exe&quot;" ContinueOnError="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\sign.ps1&quot; -TargetPath &quot;$(TargetPath)&quot;" ContinueOnError="true" />
  </Target>
</Project>









