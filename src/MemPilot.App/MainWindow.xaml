<Window x:Class="MemPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:MemPilot.Helpers"
        mc:Ignorable="d"
        Title="{DynamicResource App_Title}" Height="780" Width="1280" MinWidth="1000" MinHeight="640" Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBg}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <helpers:ByteSizeConverter x:Key="Bytes"/>
        <helpers:CollectionEmptyToVisibility x:Key="CollEmpty"/>
        <helpers:KindTextConverter x:Key="KindText"/>
        <helpers:SignedBytesConverter x:Key="SignedBytes"/>
        <helpers:WorkloadTextConverter x:Key="WorkloadText"/>
        <helpers:IndentConverter x:Key="Indent"/>
        <helpers:CollapsedGlyphConverter x:Key="Glyph"/>
        <helpers:CategoryTextConverter x:Key="CatText"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- sidebar tab -->
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusChip}" Padding="12,9" Margin="10,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavHoverFg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shell -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="208"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource NavRailBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14">
                                        <TextBlock Text="MemPilot" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource App_Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12">
                                            <Run Text="{Binding MemoryLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding UsedPercentText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding UsedDetailText}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,4,0,0"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <DockPanel Grid.Column="1">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12,14,0">
                                    <Button Content="{DynamicResource Common_Refresh}" Click="Refresh_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="{DynamicResource Btn_MiniBar}" Click="Compact_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="{DynamicResource Btn_MinimizeToTray}" Click="ToTray_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="{DynamicResource Btn_ToggleTheme}" Click="ToggleTheme_Click" Style="{StaticResource GhostBtn}"/>
                                </StackPanel>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- cards & buttons -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="{StaticResource SpaceCard}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource WindowShadow}" Opacity="0.035" BlurRadius="10" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="ModeChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource ChipBg}" CornerRadius="10" Padding="16,9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MemBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource TrackBg}" CornerRadius="7">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBlue}" CornerRadius="7" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAltBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DgHeader}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>

        <!-- ===== v0.2.1 页面排版令牌 ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsSection}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- v0.6.0：导航分组小标题（非 TabItem，SelectionChanged 自然忽略） -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="18,12,0,4"/>
        </Style>
        <!-- 工具栏按钮：等高、轻底、hover 高亮（基于 GhostBtn 视觉） -->
        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource ChipBg}" CornerRadius="{StaticResource RadiusChip}"
                                Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="RootTabs" Grid.Row="0" SelectionChanged="TabControl_SelectionChanged">

            <!-- ============ 主页 ============ -->
            <TextBlock Text="{DynamicResource Nav_GroupCore}" Style="{StaticResource NavGroup}"/>
            <TabItem Header="{DynamicResource Nav_Home}" Tag="home" Style="{StaticResource NavTab}" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,18,20,20" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===== 主栏 ===== -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <!-- v0.10.0 首次运行说明：第一次打开时出现，点「知道了」后永久不再显示。
                                 不弹模态框（用户明确反感），就一条可关闭的横幅。 -->
                            <Border x:Name="FirstRunNotice" Style="{StaticResource Card}" Margin="0,0,0,10"
                                    Background="{DynamicResource NoticeBg}" BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource FirstRun_Title}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   Text="{DynamicResource FirstRun_Body}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11">
                                            <Hyperlink Click="OpenDataFolder_Click" Foreground="{DynamicResource AccentBlue}">
                                                <Run Text="{DynamicResource FirstRun_OpenData}"/>
                                            </Hyperlink>
                                            <Run Text="　·　"/>
                                            <Hyperlink Click="OpenReadme_Click" Foreground="{DynamicResource AccentBlue}">
                                                <Run Text="{DynamicResource FirstRun_Readme}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource FirstRun_Dismiss}" Click="DismissFirstRunNotice_Click"
                                            Style="{StaticResource GhostBtn}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="260"/>
                                        <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="300"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Home_MemoryUsage}" Style="{StaticResource CaptionText}"/>
                                        <!-- v0.11.0 P0-2：大字与详情允许换行——1280 宽窗口下固定横排曾把详情挤出卡片右缘 -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding UsedPercentText}" FontSize="52" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding UsedDetailText}" VerticalAlignment="Bottom" Margin="10,0,0,10"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap" MaxWidth="220"/>
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding UsedPercent, Mode=OneWay}" HorizontalAlignment="Stretch" Margin="0,4,0,10"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{DynamicResource Home_Available}"/><Run Text=" "/><Run Text="{Binding AvailableMemoryText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="    "/><Run Text="{DynamicResource Home_Commit}"/><Run Text=" "/><Run Text="{Binding CommitText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <!-- v0.18.0：工具自身开销（RSS/CPU/全量刷新 P95），调度器必须能自证不是负担 -->
                                        <TextBlock Text="{Binding SelfCostText}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="{DynamicResource Home_Vram}" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding GpuSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        <TextBlock Text="{Binding GpuMemorySummaryText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" ToolTip="{DynamicResource Home_VramTip}"/>
                                        <TextBlock Text="{DynamicResource Home_Trend}" Style="{StaticResource CaptionText}"/>
                                        <Viewbox Height="56" Stretch="Fill" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                            <Canvas Width="260" Height="64" Background="{DynamicResource TrackBg}" ClipToBounds="True">
                                                <Polygon Points="{Binding MemoryTrendAreaPoints}" Fill="{DynamicResource TrendAreaFill}"/>
                                                <Polyline Points="{Binding MemoryTrendPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Home_ModePrompt}" Style="{StaticResource SectionTitle}"/>
                                    <UniformGrid Columns="5" Margin="0,12,0,4">
                                        <RadioButton x:Name="ModeRbResident" Content="{DynamicResource Mode_Resident}" GroupName="HomeMode" Tag="Resident" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbDevelopment" Content="{DynamicResource Mode_Development}" GroupName="HomeMode" Tag="Development" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbGame" Content="{DynamicResource Mode_Game}" GroupName="HomeMode" Tag="Game" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbAiGeneration" Content="{DynamicResource Mode_Ai}" GroupName="HomeMode" Tag="AiGeneration" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbBalanced" Content="{DynamicResource Mode_Balanced}" GroupName="HomeMode" Tag="Balanced" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding ModeDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="2,0,0,6" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="AutoSwitchCheck" Content="{DynamicResource Home_AutoSwitch}" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Home_AiCardTitle}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{DynamicResource Home_AiCardBody}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Home_Need}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBox x:Name="HomeTargetGB" Text="8" Width="56" Margin="6,0" Padding="6,4" VerticalAlignment="Center"/>
                                            <TextBlock Text="GB" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Content="{DynamicResource Btn_GeneratePlan}" Click="HomePlan_Click" Style="{StaticResource PrimaryBtn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Home_Maintenance}" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap">
                                            回收所有候选的工作集（温和，不结束任何进程）；明细与逐项处置在「可清理」页。
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Action_TrimIdle}" Click="Optimize_Click" Style="{StaticResource PrimaryBtn}"/>
                                            <Button Content="{DynamicResource Btn_ViewCleanable}" Click="GoClean_Click" Style="{StaticResource LinkBtn}"/>
                                        </StackPanel>
                                        <!-- v0.18.0：清缓存入口前移（叙事务实：它降物理占用、不降提交） -->
                                        <TextBlock Margin="0,8,0,0" FontSize="11">
                                            <Hyperlink Click="GoSysMem_Click" Foreground="{DynamicResource AccentBlue}">
                                                <Run Text="{DynamicResource Home_ClearCache}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource Btn_AllRecords}" Click="GoDecisions_Click" Style="{StaticResource LinkBtn}"/>
                                        <TextBlock Text="{DynamicResource Home_RecentDecisions}" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding HomeDecisions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,3" FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource TimestampMuted}"/>
                                                    <Run Text="{Binding LineText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Home_TopGroups}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource Col_ProcessGroup}" Binding="{Binding DisplayName}" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource Col_Count}" Binding="{Binding Count}" Width="70"/>
                                            <DataGridTextColumn Header="{DynamicResource Col_WorkingSet}" Binding="{Binding TotalWorkingSetBytes, Converter={StaticResource Bytes}}" Width="100"/>
                                            <DataGridTextColumn Header="{DynamicResource Home_Commit}" Binding="{Binding TotalCommitBytes, Converter={StaticResource Bytes}}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 洞察栏 ===== -->
                        <StackPanel Grid.Column="1">
                            <!-- v0.11.0 P1-3：提交告急 L3 非模态确认卡（原为模态 MessageBox，随时抢焦点）。
                                 确认动作不变（逐个优雅关闭、永不强制），只是不再打断手头的事。 -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding CommitReliefPending, Converter={StaticResource BoolToVis}}"
                                    BorderBrush="{DynamicResource WarnBg}" Background="{DynamicResource WarnBg}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Relief_Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarnFg}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" Margin="0,4,0,0" FontSize="12">
                                        <Run Text="{DynamicResource Relief_Body}"/>
                                        <Run Text="{Binding CommitReliefNames, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource Relief_ReclaimCommit}"/>
                                        <Run Text="{Binding CommitReliefReclaimMb, Mode=OneWay, StringFormat={}{0} MB}"/>
                                        <Run Text="{DynamicResource Relief_BodyEnd}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Btn_ConfirmClose}" Click="ConfirmCommitRelief_Click" Style="{StaticResource DangerBtn}"/>
                                        <Button Content="{DynamicResource Btn_GiveUp}" Click="DismissCommitRelief_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- v0.15.0：垃圾进程建议卡（整天未使用的垃圾进程）。
                                 只建议不执行：挂起 2h/8h 到期自动恢复；结束进程走既有确认流程。 -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding JunkAdvicePending, Converter={StaticResource BoolToVis}}"
                                    BorderBrush="{DynamicResource NoticeBorder}" Background="{DynamicResource NoticeBg}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Junk_Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarnFg}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" Margin="0,4,0,0" FontSize="12">
                                        <Run Text="{Binding JunkAdviceNames, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource Junk_Reclaim}"/>
                                        <Run Text="{Binding JunkAdviceTotalMb, Mode=OneWay, StringFormat={}{0} MB}"/>
                                        <Run Text="{DynamicResource Junk_BodyEnd}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Btn_Suspend2h}" Click="SuspendJunk2h_Click" Style="{StaticResource PrimaryBtn}"/>
                                        <Button Content="{DynamicResource Btn_Suspend8h}" Click="SuspendJunk8h_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                                        <Button Content="{DynamicResource Btn_EndProcess}" Click="CleanupJunk_Click" Style="{StaticResource DangerBtn}" Margin="8,0,0,0"/>
                                        <Button Content="{DynamicResource Common_Ignore}" Click="DismissJunkAdvice_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}" BorderBrush="{DynamicResource WarnBg}" Background="{DynamicResource WarnBg}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AlertBannerTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarnFg}"/>
                                    <TextBlock Text="{Binding AlertBannerText}" TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" Margin="0,4,0,0" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Btn_MakeRoomNow}" Click="QuickRelief_Click" Style="{StaticResource PrimaryBtn}"/>
                                        <Button Content="{DynamicResource Common_Ignore}" Click="DismissAlert_Click" Style="{StaticResource GhostBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Home_HabitCard}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding HabitHintText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding AiSessionText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Home_Pending}" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Home_CleanableCandidates}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnusedCandidates.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Home_Suspended}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SuspendedProcesses.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Home_UnknownReview}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewQueue.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Button Content="{DynamicResource Btn_Handle}" Click="GoClean_Click" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Home_QuickActions}" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{DynamicResource Action_TrimIdle}" Click="TrimAllWs_Click" Style="{StaticResource PrimaryBtn}"/>
                                        <Button Content="{DynamicResource Btn_SweepJunk}" Click="SweepJunk_Click" Style="{StaticResource GhostBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 进程 ============ -->
            <TabItem Header="{DynamicResource Nav_Process}" Tag="process" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Process_Hint}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <WrapPanel>
                            <TextBox x:Name="SearchBox" Width="200" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" Padding="6,5" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="WorkloadFilterBox" Width="104" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{DynamicResource Process_WorkloadFilter}" SelectionChanged="WorkloadFilter_Changed">
                                <ComboBoxItem Content="{DynamicResource Filter_AllWorkloads}" Tag=""/>
                                <ComboBoxItem Content="{DynamicResource Term_Work}" Tag="work"/>
                                <ComboBoxItem Content="{DynamicResource Term_Entertainment}" Tag="entertainment"/>
                                <ComboBoxItem Content="AI" Tag="ai"/>
                                <ComboBoxItem Content="{DynamicResource Term_System}" Tag="system"/>
                                <ComboBoxItem Content="{DynamicResource Term_Other}" Tag="other"/>
                                <ComboBoxItem Content="{DynamicResource Term_Unknown}" Tag="unknown"/>
                            </ComboBox>
                            <ToggleButton x:Name="TreeModeToggle" Content="{DynamicResource Btn_TreeView}" Style="{StaticResource ToolToggle}" Checked="TreeMode_Changed" Unchecked="TreeMode_Changed" Margin="0,0,8,0"/>
                            <Button x:Name="ColumnMenuButton" Content="{DynamicResource Btn_Columns}" Style="{StaticResource ToolBtn}" Click="ColumnMenu_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="ColumnMenu_Opened">
                                        <!-- Tag = 稳定 id（写进 config.json），Header = 显示文本。
                                             v0.10.0 起两者分离，否则加语言会让列设置静默重置。
                                             v0.11.0：12 项平铺 → 4 组（标识/内存/显存/证据），组头禁用项仅作标题 -->
                                        <MenuItem Header="{DynamicResource Col_Identity}" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="{DynamicResource Col_Program}" Tag="program" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_WindowTitle}" Tag="window_title" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Vendor}" Tag="vendor" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Threads}" Tag="threads" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Children}" Tag="child_count" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Memory}" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="{DynamicResource Col_MemoryGrowth}" Tag="memory_growth" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Audio}" Tag="audio" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Concept_Protected}" Tag="protected" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_ModeKeep}" Tag="mode_keep" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Vram}" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="{DynamicResource Col_Vram}" Tag="gpu_memory" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_Evidence}" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="{DynamicResource Col_Signature}" Tag="signature" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="{DynamicResource Col_CategoryReason}" Tag="category_reason" IsCheckable="True" Click="ColumnToggle_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="10,0" VerticalAlignment="Center"/>
                            <!-- v0.6.0：图例升级为筛选芯片（互斥；全部=清空） -->
                            <ToggleButton x:Name="ChipAll" Content="{DynamicResource Filter_All}" Style="{StaticResource ToolToggle}" IsChecked="True" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipSystem" Content="{DynamicResource Filter_SystemProtected}" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipGame" Content="{DynamicResource Term_Game}" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipAi" Content="AI" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipUnknown" Content="{DynamicResource Term_Unrecognized}" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click"/>
                        </WrapPanel>
                    </DockPanel>
                    <Grid Grid.Row="1"><DataGrid x:Name="ProcessGrid" ItemsSource="{Binding FilteredProcesses}" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="2" SelectionChanged="ProcessGrid_SelectionChanged" MouseDoubleClick="ProcessGrid_DoubleClick" Sorting="ProcessGrid_Sorting">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="SystemCritical"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="SystemService"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Driver"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="SecuritySoftware"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="AntiCheat"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Game"><Setter Property="Background" Value="{DynamicResource GameRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="GameLauncher"><Setter Property="Background" Value="{DynamicResource GameRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="AiImageVideo"><Setter Property="Background" Value="{DynamicResource AiRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource UnknownRowBg}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu_Dispose}" IsEnabled="False" FontWeight="SemiBold"/>
                                <MenuItem Header="{DynamicResource Level_L1Trim}" Click="CtxL1_Click"/>
                                <MenuItem Header="{DynamicResource Menu_Suspend}" Click="CtxL2_Click"/>
                                <MenuItem Header="{DynamicResource Level_L3Graceful}" Click="CtxL3_Click"/>
                                <MenuItem Header="{DynamicResource Menu_ForceKill}" Click="CtxL4_Click"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Action_Resume}" Click="CtxResumeProcess_Click"/>
                                <MenuItem Header="{DynamicResource Menu_Threads}" Click="ManageThreads_Click"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Menu_MemoryPolicy}" IsEnabled="False" FontWeight="SemiBold"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Menu_LowerPriority}" Click="CtxMemPriorityLow_Click"/>
                                <MenuItem Header="{DynamicResource Menu_RestorePriority}" Click="CtxMemPriorityNormal_Click"/>
                                <MenuItem Header="{DynamicResource Menu_EcoOn}" Click="CtxEcoOn_Click"/>
                                <MenuItem Header="{DynamicResource Menu_EcoOff}" Click="CtxEcoOff_Click"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource Menu_Mark}" IsEnabled="False" FontWeight="SemiBold"/>
                                <MenuItem Header="{DynamicResource Menu_MarkWorkload}">
                                    <MenuItem Header="{DynamicResource Term_Work}" Tag="Work" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="{DynamicResource Term_Entertainment}" Tag="Entertainment" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="AI" Tag="Ai" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="{DynamicResource Term_System}" Tag="System" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="{DynamicResource Term_Other}" Tag="Other" Click="CtxWorkload_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource Menu_ClearWorkload}" Tag="" Click="CtxWorkload_Click"/>
                                </MenuItem>
                                <MenuItem Header="{DynamicResource Menu_MarkKeep}" Click="CtxFeedbackKeep_Click"/>
                                <MenuItem Header="{DynamicResource Menu_MarkCleanable}" Click="CtxFeedbackClean_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                            <DataGridTemplateColumn Header="{DynamicResource Col_Name}" Width="210" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="{Binding TreeDepth, Converter={StaticResource Indent}}"/>
                                            <TextBlock Text="{Binding Collapsed, Converter={StaticResource Glyph}}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="TreeToggle_MouseDown" ToolTip="{DynamicResource Process_TreeHint}"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Col_Category}" Binding="{Binding Category, Converter={StaticResource CatText}}" Width="72"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Workload}" Binding="{Binding Workload, Converter={StaticResource WorkloadText}}" Width="60"/>
                            <DataGridTextColumn Header="{DynamicResource Col_WorkingSet}" Binding="{Binding Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource Col_PrivateWs}" Binding="{Binding Memory.PrivateWorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource Home_Commit}" Binding="{Binding Memory.PrivateBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="CPU%" Binding="{Binding Memory.CpuPercent, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Vram}" Binding="{Binding GpuMemoryText}" Width="80"/>
                            <DataGridTextColumn Header="{DynamicResource Col_IdleMin}" Binding="{Binding IdleMinutes, StringFormat=F0}" Width="65"/>
                            <DataGridTextColumn Header="{DynamicResource Col_MemoryGrowth}" Binding="{Binding MemoryGrowthBytes, Converter={StaticResource SignedBytes}}" Width="85"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Children}" Binding="{Binding ChildPids.Count}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Threads}" Binding="{Binding Memory.ThreadCount}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Program}" Binding="{Binding ProgramDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Vendor}" Binding="{Binding Company}" Width="130"/>
                            <DataGridTextColumn Header="{DynamicResource Col_WindowTitle}" Binding="{Binding MainWindowTitle}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Audio}" Binding="{Binding AudioActive}" Width="45"/>
                            <DataGridTextColumn Header="{DynamicResource Concept_Protected}" Binding="{Binding IsProtected}" Width="45"/>
                            <DataGridTextColumn Header="{DynamicResource Col_ModeKeep}" Binding="{Binding ModeKeep}" Width="60"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Signature}" Binding="{Binding SignatureVerified}" Width="45"/>
                            <DataGridTextColumn Header="{DynamicResource Col_CategoryReason}" Binding="{Binding CategoryReason}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <TextBlock Text="{DynamicResource Empty_Processes}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"
                                   TextAlignment="Center" FontSize="12"
                                   Visibility="{Binding FilteredProcesses, Converter={StaticResource CollEmpty}}"/></Grid>
                </Grid>
            </TabItem>

            <!-- ============ 可清理 ============ -->
            <TabItem Header="{DynamicResource Nav_Cleanup}" Tag="cleanup" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Cleanup_Hint}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CandidateRuleText}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Expander Grid.Row="1" Margin="0,0,0,6" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="{Binding ReviewQueueHeader}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </Expander.Header>
                        <StackPanel>
                            <DataGrid x:Name="ReviewGrid" ItemsSource="{Binding ReviewQueue}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="140" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                                    <DataGridTextColumn Header="{DynamicResource Col_Name}" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Col_WorkingSet}" Binding="{Binding Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                                    <DataGridTextColumn Header="{DynamicResource Col_Publisher}" Binding="{Binding Company}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Col_Path}" Binding="{Binding ExecutablePath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{DynamicResource Menu_MarkJunk}" Click="ReviewMarkClean_Click" Style="{StaticResource DangerBtn}"/>
                                <Button Content="{DynamicResource Menu_MarkKeepShort}" Click="ReviewMarkKeep_Click" Style="{StaticResource PrimaryBtn}"/>
                                <Button Content="{DynamicResource Menu_OnlineLookup}" Click="ReviewLookup_Click" Style="{StaticResource PrimaryBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Grid Grid.Row="2"><DataGrid x:Name="UnusedGrid" ItemsSource="{Binding UnusedCandidates}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="UnusedGrid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Menu_L1}" Click="CtxL1_Click"/>
                                <MenuItem Header="{DynamicResource Menu_L2}" Click="CtxL2_Click"/>
                                <MenuItem Header="{DynamicResource Menu_L3}" Click="CtxL3_Click"/>
                                <MenuItem Header="{DynamicResource Btn_ForceKillConfirm}" Click="CtxL4_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Process.Pid}" Width="60"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Name}" Binding="{Binding Process.Name}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Category}" Binding="{Binding Process.Category}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource Col_WorkingSet}" Binding="{Binding Process.Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource Col_EstPhys}" Binding="{Binding EstimatedReclaimableBytes, Converter={StaticResource Bytes}}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource Term_Idle}" Binding="{Binding Process.IdleMinutes, StringFormat=F0}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Col_ResidentScore}" Binding="{Binding JunkScore, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Col_SuggestedLevel}" Binding="{Binding SuggestedLevel}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource Col_Reason}" Binding="{Binding ReasonsText}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <TextBlock Text="{DynamicResource Empty_Cleanup}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"
                                   TextAlignment="Center" FontSize="12"
                                   Visibility="{Binding UnusedCandidates, Converter={StaticResource CollEmpty}}"/></Grid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0">
                            <Button Content="{DynamicResource Action_L1TrimShort}" Click="L1_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="{DynamicResource Action_L2Short}" Click="L2_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="{DynamicResource Action_L3Short}" Click="L3_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="{DynamicResource Btn_ForceKillConfirm}" Click="L4_Click" Style="{StaticResource DangerBtn}"/>
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                            <Menu Background="Transparent" Padding="0" Margin="0,0,10,0">
                                <MenuItem Header="{DynamicResource Btn_Batch}" Padding="10,5">
                                    <MenuItem Header="{DynamicResource Menu_BatchL1}" Click="BatchL1_Click"/>
                                    <MenuItem Header="{DynamicResource Menu_BatchAll}" Click="BatchSuggested_Click"/>
                                    <MenuItem Header="{DynamicResource Menu_BatchJunk}" Click="SweepJunk_Click"/>
                                </MenuItem>
                            </Menu>
                            <TextBlock x:Name="SelectionHint" Text="{DynamicResource Cleanup_SelectRow}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 腾内存 ============ -->
            <TabItem Header="{DynamicResource Nav_MakeRoom}" Tag="makeroom" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- v0.18.0：清缓存作为腾内存的第 0 步（诚实标注：降物理占用，不降提交） -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                            Background="{DynamicResource NoticeBg}" BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MakeRoom_Step0}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource MakeRoom_Step0Body}"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,4,0,8"
                                       TextWrapping="Wrap" MaxWidth="760"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Btn_GoClearCache}" Click="GoSysMem_Click" Style="{StaticResource PrimaryBtn}"/>
                                <TextBlock Text="{DynamicResource MakeRoom_Step0Note}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MakeRoom_Title}" Style="{StaticResource SectionTitle}"/>
                            <!-- v0.11.0 P0-3：原先是 2 输入 + 3 复选框 + 2 标签挤一行（≈750px），1280 宽必溢出；
                                 拆成"目标 / 选项 / 动作"三行 -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource MakeRoom_TargetAvail}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetAvailGB" Text="8" Width="60" Margin="6,0,20,0" Padding="4"/>
                                <CheckBox x:Name="EnsureCommit" Content="{DynamicResource MakeRoom_EnsureCommit}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource MakeRoom_TargetCommit}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetCommitGB" Text="8" Width="60" Margin="6,0,0,0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="AllowKill" Content="{DynamicResource MakeRoom_AllowKill}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox x:Name="IncludeTrim" Content="{DynamicResource MakeRoom_IncludeTrim}" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{DynamicResource Btn_GeneratePlanShort}" Click="PlanMakeRoom_Click" Style="{StaticResource PrimaryBtn}"/>
