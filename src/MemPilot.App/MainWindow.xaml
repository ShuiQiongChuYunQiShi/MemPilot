                </Grid>
            </TabItem>

            <!-- ============ 挂起/处置 ============ -->
            <TabItem Header="⏸️  挂起/处置" Tag="suspend" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MaxHeight="260"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="被本工具挂起的进程（挂起只冻结 CPU，不释放内存；请记得恢复）" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}"/>
                    <!-- v0.11.0：原先是裸 ListBox（显示 ToString 原文）且两个 * 行强对半——空列表也占半页 -->
                    <ListBox x:Name="SuspendedList" Grid.Row="1" ItemsSource="{Binding SuspendedProcesses}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="最近被本工具关闭/结束的程序（记录 exe 路径，可一键重新启动）" Margin="0,10,0,8" Foreground="{DynamicResource TextSecondary}"/>
                    <DataGrid x:Name="DisposalsGrid" Grid.Row="3" ItemsSource="{Binding DisposalRecords}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170"/>
                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="130"/>
                            <DataGridTextColumn Header="已退出" Binding="{Binding Exited}" Width="60"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding ExePath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="恢复选中挂起" Click="ResumeSelected_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="恢复全部挂起" Click="ResumeAll_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="重启选中程序" Click="RestartDisposal_Click" Style="{StaticResource PrimaryBtn}" Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 决策日志 ============ -->
            <TextBlock Text="观测" Style="{StaticResource NavGroup}"/>
            <TabItem Header="🧠  决策日志" Tag="decisions" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="引擎的每个自动决定：为什么切换模式、执行/跳过了谁、跳过原因（自动行为可解释）" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}"/>
                    <Grid><DataGrid Grid.Row="1" ItemsSource="{Binding DecisionEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding Kind, Converter={StaticResource KindText}}" Width="110"/>
                            <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="220"/>
                            <DataGridTextColumn Header="决定" Binding="{Binding Decision}" Width="130"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <TextBlock Text="还没有记录。引擎的每个自动决定都会出现在这里——包括它「跳过」了谁、为什么跳过。" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"
                                   TextAlignment="Center" FontSize="12"
                                   Visibility="{Binding DecisionEntries, Converter={StaticResource CollEmpty}}"/></Grid>
                </Grid>
            </TabItem>

            <!-- ============ 历史 ============ -->
            <TabItem Header="📊  历史" Tag="history" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,14,14,20" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新统计" Click="LoadHistory_Click" Style="{StaticResource PrimaryBtn}"/>
