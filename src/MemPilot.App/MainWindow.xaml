                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新统计" Click="LoadHistory_Click" Style="{StaticResource PrimaryBtn}"/>
                                    <TextBlock Text="使用习惯记录（每 5 分钟一个采样点，本地保存 30 天）" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding HistorySummary}" Margin="0,6,0,8" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                <Canvas Width="700" Height="160" Background="{DynamicResource TrackBg}" HorizontalAlignment="Left">
                                    <Line X1="0" Y1="10" X2="640" Y2="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="80" X2="640" Y2="80" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="150" X2="640" Y2="150" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="2" Text="100%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="72" Text="50%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="142" Text="0%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <Polygon Points="{Binding HistoryAreaPoints}" Fill="#332563EB"/>
                                    <Polyline Points="{Binding HistoryPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                </Canvas>
                                <TextBlock Text="上：24 小时内存占用率（越高越紧张；可用 GB 见上方摘要）" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="显存（每 30 秒采样，本地保存 30 天）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding GpuHistorySummary}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Canvas Width="700" Height="160" Background="{DynamicResource TrackBg}" HorizontalAlignment="Left">
                                    <Line X1="0" Y1="10" X2="640" Y2="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="80" X2="640" Y2="80" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="150" X2="640" Y2="150" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="2" Text="100%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="72" Text="50%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="142" Text="0%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <Polygon Points="{Binding GpuHistoryAreaPoints}" Fill="#3355C8A5"/>
                                    <Polyline Points="{Binding GpuHistoryPoints}" Stroke="{DynamicResource AccentGreen}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                </Canvas>
                                <TextBlock Text="上：24 小时显存占用率（越高越紧张；按适配器总容量折算，采集不可用时为空）" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/>
                                <DataGrid ItemsSource="{Binding GpuUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="170"/>
                                        <DataGridTextColumn Header="峰值专用" Binding="{Binding PeakDedicatedBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="均值专用" Binding="{Binding AvgDedicatedBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="峰值共享" Binding="{Binding PeakSharedBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="出现采样" Binding="{Binding Seen}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="这张表是将来「AI 生成前申请显存、结束后归还」的验收基线：先看清谁在吃、吃多少、什么时候吃。" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="模式使用时长（7 天）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ModeUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="模式 / 时长" Binding="{Binding Display}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="动作计数（7 天，来自审计）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ActionUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="吃内存大户（24 小时均值 Top12）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding TopUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="170"/>
                                        <DataGridTextColumn Header="平均私有WS" Binding="{Binding AvgWsMb, StringFormat={}{0:F0} MB}" Width="110"/>
                                        <DataGridTextColumn Header="峰值" Binding="{Binding MaxWsMb, StringFormat={}{0:F0} MB}" Width="100"/>
                                        <DataGridTextColumn Header="平均CPU%" Binding="{Binding AvgCpu}" Width="90"/>
                                        <DataGridTextColumn Header="平均线程" Binding="{Binding Threads, StringFormat=F0}" Width="90"/>
                                        <DataGridTextColumn Header="出现采样" Binding="{Binding Seen}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="这些数据也是将来 AI 功能（习惯学习、腾挪预测、异常检测）的训练地基。" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 操作审计 ============ -->
            <TabItem Header="📜  操作审计" Style="{StaticResource NavTab}">
                <DataGrid Margin="14,14,14,0" ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="160"/>
                        <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="200"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="160"/>
                        <DataGridTextColumn Header="清理前" Binding="{Binding MemoryBeforeBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridTextColumn Header="清理后" Binding="{Binding MemoryAfterBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ============ 线程 ============ -->
            <TabItem Header="🧵  线程" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="ThreadSearchBox" Width="260" Margin="0,0,8,0" Padding="6,4" KeyUp="ThreadSearch_KeyUp"/>
                        <TextBlock Text="按 PID 或 TID 过滤（回车应用）" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="ThreadGrid" ItemsSource="{Binding Threads}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="挂起线程" Click="CtxSuspendThread_Click"/>
                                <MenuItem Header="恢复线程" Click="CtxResumeThread_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding OwnerPid}" Width="60"/>
                            <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="70"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="等待原因" Binding="{Binding WaitReason}" Width="120"/>
                            <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                            <DataGridTextColumn Header="CPU 时间" Binding="{Binding TotalCpuTime}" Width="100"/>
                            <DataGridTextColumn Header="启动时间" Binding="{Binding StartTime}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============ 模式 ============ -->
            <TabItem Header="🎚️  模式" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="场景识别（影子模式：只判定、不切换）" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding SceneSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="娱乐" Style="{StaticResource CaptionText}"/>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding SceneGame, Mode=OneWay}" Maximum="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="AI 生成" Style="{StaticResource CaptionText}"/>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding SceneAi, Mode=OneWay}" Maximum="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="开发" Style="{StaticResource CaptionText}"/>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding SceneDev, Mode=OneWay}" Maximum="100"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SceneReason}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="场景模式与规则" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                        <ListBox x:Name="ModeList" Height="200" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="ModeList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="应用选中模式" Click="ApplyMode_Click" Style="{StaticResource PrimaryBtn}"/>
                        </StackPanel>
                        <TextBlock Text="编辑选中模式的规则（每行一个关键词，匹配进程名或路径）：" Margin="0,14,0,4" Foreground="{DynamicResource TextPrimary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="KeepPatterns（保留，不参与自动清理）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="KeepPatternsEditor" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CleanPatterns（清理名单，自动清理的作用范围）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="CleanPatternsEditor" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存该模式规则" Click="SaveModeRules_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock x:Name="ModeEditorHint" Text="（选中上方模式后编辑）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Text="模式配置保存在 config.json；自动切换带滞回（连续两轮确认 + 60 秒冷却）。" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 反馈 ============ -->
            <TabItem Header="💬  反馈" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 说明：之前这段文字和输入框都落在 Grid 第 0 行，视觉上叠在一起 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="这些反馈做什么" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       Text="告诉分类器「这个进程该怎么对待」：标记需保留 → 永不进清理候选；标记可清理 → 只需 2 轮观察即可成为候选；标记为系统 → 视为受保护。反馈只保存在本机（%APPDATA%\MemPilot\feedback.json），不上传，下一次刷新生效。最方便的用法是在「进程」页右键那个进程直接标记。"/>
                            <TextBlock Text="{Binding FeedbackEntries.Count, StringFormat=已记录 {0} 条 · 右键表格行可撤销}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="进程名（必填，或填路径）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="FbName" Padding="6,4" Margin="0,2,0,0" ToolTip="与任务管理器一致，例如 wegame.exe"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="可执行文件路径（可选；填了按路径精确匹配，软件级反馈按目录匹配）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="FbPath" Padding="6,4" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="把它归类为" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="FbCategory" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="备注（可选，只给自己看）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="FbNote" Padding="6,4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2" x:Name="FeedbackGrid" ItemsSource="{Binding FeedbackEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="撤销这条反馈（删除标记）" Click="DeleteFeedback_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="100"/>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding ReportedCategory, Converter={StaticResource CatText}}" Width="120"/>
                            <DataGridTextColumn Header="效果" Binding="{Binding EffectText}" Width="160"/>
                            <DataGridTextColumn Header="用途" Binding="{Binding WorkloadMarkText}" Width="60"/>
                            <DataGridTextColumn Header="范围" Binding="{Binding ScopeText}" Width="60"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding UserNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="提交反馈" Click="SubmitFeedback_Click" Style="{StaticResource PrimaryBtn}"/>
                        <CheckBox x:Name="FbKeep" Content="标记需保留" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FbClean" Content="标记可清理" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FbSystem" Content="标记为系统进程（受保护）" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="至少填进程名或路径，否则这条反馈不会生效" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 系统内存清理 ============ -->
            <TabItem Header="🧼  系统内存清理" Style="{StaticResource NavTab}">
                <ScrollViewer Margin="14,14,14,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="系统内存区域清理（需要管理员权限）" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="注意：完整清理备用列表会让游戏重新读盘造成卡顿；游戏运行时建议只使用低优先级备用列表。" Foreground="{DynamicResource AccentRed}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <CheckBox x:Name="ChkCombinedPageList" Content="Combined Page List（合并页列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkModifiedFileCache" Content="Modified File Cache（修改的文件缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkModifiedPageList" Content="Modified Page List（修改的页列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkRegistryCache" Content="Registry Cache（注册表缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkStandbyList" Content="Standby List（备用列表 - 完整，游戏运行时慎用）" Margin="0,4"/>
                        <CheckBox x:Name="ChkStandbyListLow" Content="Standby List (Low Priority)（低优先级备用列表 - 推荐）" Margin="0,4"/>
                        <CheckBox x:Name="ChkSystemFileCache" Content="System File Cache（系统文件缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkWorkingSet" Content="Working Set（工作集 - 所有进程，逐进程压缩，无需管理员）" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="清理选中区域" Click="CleanMemoryAreas_Click" Style="{StaticResource DangerBtn}"/>
                            <Button Content="压缩全部进程工作集（无需管理员）" Click="TrimAllWs_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" ToolTip="逐进程回收工作集：只压缩不结束，跳过后台忙碌/受保护进程"/>
                            <Button Content="全选" Click="SelectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                            <Button Content="取消全选" Click="DeselectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="CleanResultText" Text="" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 设置 ============ -->
            <TabItem Header="⚙️  设置" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,20" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="阈值配置" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="未使用 CPU 阈值 (%)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetCpu" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="未使用空闲分钟数" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetIdle" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="刷新间隔 (秒)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetRefresh" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="进程最小存活期 (秒，保护刚启动的进程)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetMinAge" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="连续空闲观察轮数 (候选门槛)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetObservations" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="优雅关闭超时 (秒)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetGraceful" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自动化" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoCleanup" Content="启用模式驱动的自动清理（仅 L1 回收 / 可选 L3 优雅关闭，从不自动 L4）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoClose" Content="自动清理时允许优雅关闭（L3）" Margin="16,3"/>
                                <CheckBox x:Name="SetAutoOptimize" Content="启用系统内存自动优化（低内存时清理低优先级备用列表）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoOptimizeInterval" Content="另按固定周期清理（不推荐，可能影响游戏）" Margin="16,3"/>
                                <CheckBox x:Name="SetAutoJunkSweep" Content="自动清理垃圾驻守（无窗口/无音频的 Bloatware 与孤儿残留；Windows 服务、受保护进程永不触碰）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoJunkSweepOrphansOnly" Content="低风险模式：自动清扫只清「宿主已退出的孤儿残留」，不动常驻垃圾" Margin="16,3"/>
                                <CheckBox x:Name="SetShowAlerts" Content="重要提示触达（托盘气泡 + 主页横幅；取消勾选 = 仅写决策日志）" Margin="0,3"/>
                                <Button Content="应用低风险自动档（自动优化 + 仅清孤儿残留，清理仍只 L1）" Click="ApplyLowRiskPreset_Click" Style="{StaticResource PrimaryBtn}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="SetSkipFullscreen" Content="前台全屏（游戏）时跳过系统级清理" IsChecked="True" Margin="16,3"/>
                                <CheckBox x:Name="SetEventLog" Content="审计同步写入 Windows 事件日志（来源注册需要一次管理员运行）" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="显存采样" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetGpuSampling" Content="记录显存历史（逐进程专用/共享显存，独立落盘到 history\gpu-*.jsonl）" Margin="0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="采样间隔" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SetGpuInterval" Width="120" VerticalAlignment="Center">
                                        <ComboBoxItem Content="15 秒" Tag="15"/>
                                        <ComboBoxItem Content="30 秒（推荐）" Tag="30"/>
                                        <ComboBoxItem Content="60 秒" Tag="60"/>
                                        <ComboBoxItem Content="5 分钟" Tag="300"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="AI 生成视频时显存尖峰通常只有 1–2 分钟，30 秒采样才能留住形状；采样本身只读 PDH 计数器，不处置任何进程。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="驻守" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoStart" Content="开机自启（勾选即生效）" Margin="0,3" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                <CheckBox x:Name="SetStartMinimized" Content="启动时最小化到托盘" Margin="0,3" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
                                <CheckBox x:Name="SetResumeOnModeChange" Content="模式切换时自动恢复被挂起的进程" Margin="0,3" Checked="ResumeOnChange_Changed" Unchecked="ResumeOnChange_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <CheckBox x:Name="SetHotkeyEnabled" Content="全局热键一键腾内存：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SetHotkey" Width="150" Margin="8,0,0,0" ToolTip="格式：CTRL+SHIFT+M / ALT+F9 等"/>
                                </StackPanel>
                                <TextBlock Text="热键动作：唤起主窗 → 打开腾内存页 → 按主页的目标 GB 生成计划（仍需手动确认执行）。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="程序清单" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ProgramCatalogInfo}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                <Button Content="重建程序清单（注册表 + 开始菜单 + 安装根）" Click="RebuildCatalog_Click" Style="{StaticResource PrimaryBtn}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="联网查询" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="查询端点 URL" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetEndpoint" Width="440" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                <TextBlock Text="API 密钥（仅存本机 config.json）" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetApiKey" Width="440" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                <CheckBox x:Name="SetOnlineEnabled" Content="启用联网查询" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="场景影子校准（近 7 天）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ShadowCalibrationText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StoreDiagnosticsText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button Content="刷新校准数据" Click="RefreshShadowCalibration_Click" Style="{StaticResource GhostBtn}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="名单管理" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="受保护进程" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="ProtectedListEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="白名单（不参与清理）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="WhitelistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="黑名单（观察 2 轮即可候选）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="BlacklistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock Text="所有配置保存在 %APPDATA%\MemPilot\config.json" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="控制台模式：MemPilot.exe /standbylistlowpriority | /reset" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
