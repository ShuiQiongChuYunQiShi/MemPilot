                        <CheckBox x:Name="ChkStandbyListLow" Content="{DynamicResource SysMem_StandbyListLow}" Margin="0,4"/>
                        <CheckBox x:Name="ChkSystemFileCache" Content="{DynamicResource SysMem_SystemFileCache}" Margin="0,4"/>
                        <CheckBox x:Name="ChkCombinedMemory" Content="{DynamicResource SysMem_CombinedMemory}" Margin="0,4"/>
                        <CheckBox x:Name="ChkWorkingSet" Content="{DynamicResource SysMem_WorkingSet}" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Btn_CleanSelected}" Click="CleanMemoryAreas_Click" Style="{StaticResource DangerBtn}"/>
                            <Button Content="{DynamicResource Btn_TrimAll}" Click="TrimAllWs_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" ToolTip="{DynamicResource Btn_TrimAllTip}"/>
                            <Button Content="{DynamicResource Btn_SelectAll}" Click="SelectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                            <Button Content="{DynamicResource Btn_DeselectAll}" Click="DeselectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="CleanResultText" Text="" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 设置 ============ -->
            <TabItem Header="{DynamicResource Nav_Settings}" Tag="settings" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,20" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Thresholds}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Settings_CpuThreshold}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetCpu" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="{DynamicResource Settings_IdleMinutes}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetIdle" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="{DynamicResource Settings_RefreshInterval}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetRefresh" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Settings_MinAge}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetMinAge" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="{DynamicResource Settings_Observations}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetObservations" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="{DynamicResource Settings_GracefulTimeout}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetGraceful" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- v0.19.0：语言切换（运行时生效，无需重启） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Language}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="SetLanguage" Width="180" SelectionChanged="Language_Changed">
                                        <ComboBoxItem Content="{DynamicResource Lang_Auto}" Tag="auto"/>
                                        <ComboBoxItem Content="{DynamicResource Lang_Chinese}" Tag="zh-CN"/>
                                        <ComboBoxItem Content="English" Tag="en"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource Settings_LanguageHint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" MaxWidth="420"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Automation}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoCleanup" Content="{DynamicResource Settings_AutoCleanup}" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoClose" Content="{DynamicResource Settings_AutoClose}" Margin="16,3"/>
                                <CheckBox x:Name="SetAutoJunkSweep" Content="{DynamicResource Settings_AutoJunkSweep}" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoJunkSweepOrphansOnly" Content="{DynamicResource Settings_OrphansOnly}" Margin="16,3"/>
                                <CheckBox x:Name="SetJunkAdvice" Content="{DynamicResource Settings_JunkAdvice}" Margin="0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="16,2,0,0">
                                    <Button Content="{DynamicResource Btn_CheckJunkNow}" Click="ForceJunkAdvice_Click" Style="{StaticResource GhostBtn}" Padding="10,2"/>
                                    <TextBlock Text="{DynamicResource Settings_JunkCooldown}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="SetAutoCommitRelief" Content="{DynamicResource Settings_CommitRelief}" Margin="0,3"/>
                                <CheckBox x:Name="SetCommitReliefL3" Content="{DynamicResource Settings_CommitReliefL3}" Margin="16,3"/>
                                <CheckBox x:Name="SetShowAlerts" Content="{DynamicResource Settings_Alerts}" Margin="0,3"/>
                                <Button Content="{DynamicResource Settings_LowRiskProfile}" Click="ApplyLowRiskPreset_Click" Style="{StaticResource PrimaryBtn}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="SetEventLog" Content="{DynamicResource Settings_EventLog}" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_GpuSampling}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetGpuSampling" Content="{DynamicResource Settings_GpuHistory}" Margin="0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="{DynamicResource Settings_SampleInterval}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SetGpuInterval" Width="120" VerticalAlignment="Center">
                                        <ComboBoxItem Content="{DynamicResource Interval_15s}" Tag="15"/>
                                        <ComboBoxItem Content="{DynamicResource Interval_30s}" Tag="30"/>
                                        <ComboBoxItem Content="{DynamicResource Interval_60s}" Tag="60"/>
                                        <ComboBoxItem Content="{DynamicResource Interval_5m}" Tag="300"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_GpuNote}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_LeaseApi}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetLeaseApi" Content="{DynamicResource Settings_LeaseEnabled}" Margin="0,3"/>
                                <TextBlock Text="{Binding LeaseApiStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="16,2,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="{DynamicResource Settings_Port}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SetLeasePort" Width="90" Padding="6,4" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="{DynamicResource Settings_Token}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SetLeaseToken" Width="430" IsReadOnly="True" Padding="6,4" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="{DynamicResource Btn_Regenerate}" Click="RegenerateLeaseToken_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_LeaseNote}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Resident}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoStart" Content="{DynamicResource Settings_AutoStart}" Margin="0,3" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                <CheckBox x:Name="SetStartMinimized" Content="{DynamicResource Settings_StartMinimized}" Margin="0,3" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
                                <CheckBox x:Name="SetResumeOnModeChange" Content="{DynamicResource Settings_ResumeOnModeChange}" Margin="0,3" Checked="ResumeOnChange_Changed" Unchecked="ResumeOnChange_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <CheckBox x:Name="SetHotkeyEnabled" Content="{DynamicResource Settings_Hotkey}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SetHotkey" Width="150" Margin="8,0,0,0" ToolTip="{DynamicResource Settings_HotkeyFormat}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings_HotkeyNote}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_ProgramCatalog}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ProgramCatalogInfo}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                <Button Content="{DynamicResource Btn_RebuildCatalog}" Click="RebuildCatalog_Click" Style="{StaticResource PrimaryBtn}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_OnlineLookup}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{DynamicResource Settings_Endpoint}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetEndpoint" HorizontalAlignment="Left" Width="440" Margin="0,2,0,10"/>
                                <TextBlock Text="{DynamicResource Settings_ApiKey}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetApiKey" HorizontalAlignment="Left" Width="440" Margin="0,2,0,10"/>
                                <CheckBox x:Name="SetOnlineEnabled" Content="{DynamicResource Settings_OnlineEnabled}" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_SceneShadow}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ShadowCalibrationText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StoreDiagnosticsText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button Content="{DynamicResource Btn_RefreshCalibration}" Click="RefreshShadowCalibration_Click" Style="{StaticResource GhostBtn}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Lists}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Settings_Protected}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="ProtectedListEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Settings_Whitelist}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="WhitelistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings_Blacklist}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="BlacklistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Btn_SaveSettings}" Click="SaveSettings_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock Text="{DynamicResource Settings_ConfigPath}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Settings_ConsoleMode}" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,6">
                <ProgressBar DockPanel.Dock="Right" Width="70" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsIndeterminate="True" Visibility="{Binding LongOp, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding LongOpText}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <!-- v0.11.0 P0-1：状态双轨。动作反馈（60 秒保留）加粗着色显示，刷新噪音为次要段 -->
                <TextBlock Text="{Binding StatusDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActionStatus}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
