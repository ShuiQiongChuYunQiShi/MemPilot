<Window x:Class="MemPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:MemPilot.Helpers"
        mc:Ignorable="d"
        Title="MemPilot - 内存领航员" Height="780" Width="1280" MinWidth="1000" MinHeight="640" Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBg}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <helpers:ByteSizeConverter x:Key="Bytes"/>
        <helpers:CollectionEmptyToVisibility x:Key="CollEmpty"/>
        <helpers:KindTextConverter x:Key="KindText"/>
        <helpers:SignedBytesConverter x:Key="SignedBytes"/>
        <helpers:WorkloadTextConverter x:Key="WorkloadText"/>
        <helpers:IndentConverter x:Key="Indent"/>
        <helpers:CollapsedGlyphConverter x:Key="Glyph"/>
        <helpers:CategoryTextConverter x:Key="CatText"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- sidebar tab -->
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusChip}" Padding="12,9" Margin="10,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavHoverFg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shell -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="208"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource NavRailBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14">
                                        <TextBlock Text="MemPilot" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="内存领航员" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                                        <TextBlock Text="{Binding UsedPercentText, StringFormat=内存 {0}}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Text="{Binding UsedDetailText}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,4,0,0"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <DockPanel Grid.Column="1">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12,14,0">
                                    <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="迷你条" Click="Compact_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="最小化到托盘" Click="ToTray_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="切换主题" Click="ToggleTheme_Click" Style="{StaticResource GhostBtn}"/>
                                </StackPanel>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- cards & buttons -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="{StaticResource SpaceCard}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource WindowShadow}" Opacity="0.035" BlurRadius="10" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="ModeChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource ChipBg}" CornerRadius="10" Padding="16,9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MemBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource TrackBg}" CornerRadius="7">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="{DynamicResource AccentBlue}" CornerRadius="7" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAltBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DgHeader}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>

        <!-- ===== v0.2.1 页面排版令牌 ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsSection}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- v0.6.0：导航分组小标题（非 TabItem，SelectionChanged 自然忽略） -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="18,12,0,4"/>
        </Style>
        <!-- 工具栏按钮：等高、轻底、hover 高亮（基于 GhostBtn 视觉） -->
        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource ChipBg}" CornerRadius="{StaticResource RadiusChip}"
                                Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="RootTabs" Grid.Row="0" SelectionChanged="TabControl_SelectionChanged">

            <!-- ============ 主页 ============ -->
            <TextBlock Text="核心" Style="{StaticResource NavGroup}"/>
            <TabItem Header="🏠  主页" Tag="home" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,18,20,20" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.65*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ===== 主栏 ===== -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <!-- v0.10.0 首次运行说明：第一次打开时出现，点「知道了」后永久不再显示。
                                 不弹模态框（用户明确反感），就一条可关闭的横幅。 -->
                            <Border x:Name="FirstRunNotice" Style="{StaticResource Card}" Margin="0,0,0,10"
                                    Background="{DynamicResource NoticeBg}" BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="👋 先说清楚这个工具会做什么" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   Text="默认只观察、不处置任何进程；自动清理、提交兜底、租约 API 全部默认关闭，需要你自己在设置页打开。系统级内存清理（清备用列表等）需要管理员权限，普通权限下会如实记为「跳过」而不是假装成功。所有数据只存在本机 %APPDATA%\MemPilot。"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11">
                                            <Hyperlink Click="OpenDataFolder_Click" Foreground="{DynamicResource AccentBlue}">
                                                <Run Text="打开数据目录"/>
                                            </Hyperlink>
                                            <Run Text="　·　"/>
                                            <Hyperlink Click="OpenReadme_Click" Foreground="{DynamicResource AccentBlue}">
                                                <Run Text="查看说明"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="知道了" Click="DismissFirstRunNotice_Click"
                                            Style="{StaticResource GhostBtn}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="260"/>
                                        <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="300"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="内存占用" Style="{StaticResource CaptionText}"/>
                                        <!-- v0.11.0 P0-2：大字与详情允许换行——1280 宽窗口下固定横排曾把详情挤出卡片右缘 -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding UsedPercentText}" FontSize="52" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding UsedDetailText}" VerticalAlignment="Bottom" Margin="10,0,0,10"
                                                       Foreground="{DynamicResource TextSecondary}" FontSize="13" TextWrapping="Wrap" MaxWidth="220"/>
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding UsedPercent, Mode=OneWay}" HorizontalAlignment="Stretch" Margin="0,4,0,10"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap">
                                            <Run Text="可用 "/><Run Text="{Binding AvailableMemoryText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="    提交 "/><Run Text="{Binding CommitText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="GPU 显存" Style="{StaticResource CaptionText}"/>
                                        <TextBlock Text="{Binding GpuSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        <TextBlock Text="{Binding GpuMemorySummaryText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" ToolTip="进程归属里 pid 4（System）通常是驱动层/未释放的显存，不一定是某个前台程序"/>
                                        <TextBlock Text="内存占用趋势（越高越紧张）" Style="{StaticResource CaptionText}"/>
                                        <Viewbox Height="56" Stretch="Fill" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                            <Canvas Width="260" Height="64" Background="{DynamicResource TrackBg}" ClipToBounds="True">
                                                <Polygon Points="{Binding MemoryTrendAreaPoints}" Fill="{DynamicResource TrendAreaFill}"/>
                                                <Polyline Points="{Binding MemoryTrendPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="现在在做什么？选一个场景，自动清理的范围随之改变" Style="{StaticResource SectionTitle}"/>
                                    <UniformGrid Columns="5" Margin="0,12,0,4">
                                        <RadioButton x:Name="ModeRbResident" Content="🛡️ 驻守" GroupName="HomeMode" Tag="Resident" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbDevelopment" Content="💻 开发" GroupName="HomeMode" Tag="Development" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbGame" Content="🎮 娱乐" GroupName="HomeMode" Tag="Game" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbAiGeneration" Content="🤖 AI 生成" GroupName="HomeMode" Tag="AiGeneration" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                        <RadioButton x:Name="ModeRbBalanced" Content="⚖️ 平衡" GroupName="HomeMode" Tag="Balanced" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding ModeDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="2,0,0,6" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="AutoSwitchCheck" Content="自动切换（带滞回，切换会通知）" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14">
                                    <StackPanel>
                                        <TextBlock Text="🤖 要跑 AI 生图 / 生视频了？" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="告诉它需要多少 GB，它会列出可以关闭的程序让你确认。" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="需要" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBox x:Name="HomeTargetGB" Text="8" Width="56" Margin="6,0" Padding="6,4" VerticalAlignment="Center"/>
                                            <TextBlock Text="GB" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimary}"/>
                                            <Button Content="生成计划 →" Click="HomePlan_Click" Style="{StaticResource PrimaryBtn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="🧹 日常维护" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap">
                                            回收所有候选的工作集（温和，不结束任何进程）；明细与逐项处置在「可清理」页。
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="回收闲置工作集" Click="Optimize_Click" Style="{StaticResource PrimaryBtn}"/>
                                            <Button Content="查看可清理 →" Click="GoClean_Click" Style="{StaticResource LinkBtn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="全部记录 →" Click="GoDecisions_Click" Style="{StaticResource LinkBtn}"/>
                                        <TextBlock Text="引擎最近在做什么" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding HomeDecisions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,3" FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource TimestampMuted}"/>
                                                    <Run Text="{Binding LineText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="谁在占内存（按分类汇总）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进程组" Binding="{Binding DisplayName}" Width="*"/>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70"/>
                                            <DataGridTextColumn Header="工作集" Binding="{Binding TotalWorkingSetBytes, Converter={StaticResource Bytes}}" Width="100"/>
                                            <DataGridTextColumn Header="提交" Binding="{Binding TotalCommitBytes, Converter={StaticResource Bytes}}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== 洞察栏 ===== -->
                        <StackPanel Grid.Column="1">
                            <!-- v0.11.0 P1-3：提交告急 L3 非模态确认卡（原为模态 MessageBox，随时抢焦点）。
                                 确认动作不变（逐个优雅关闭、永不强制），只是不再打断手头的事。 -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding CommitReliefPending, Converter={StaticResource BoolToVis}}"
                                    BorderBrush="{DynamicResource WarnBg}" Background="{DynamicResource WarnBg}">
                                <StackPanel>
                                    <TextBlock Text="提交内存告急——要关闭闲置后台吗？" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarnFg}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" Margin="0,4,0,0" FontSize="12">
                                        <Run Text="提交余量低于 5%。可优雅关闭："/>
                                        <Run Text="{Binding CommitReliefNames, Mode=OneWay}"/>
                                        <Run Text="，预计释放提交 "/>
                                        <Run Text="{Binding CommitReliefReclaimMb, Mode=OneWay, StringFormat={}{0} MB}"/>
                                        <Run Text="。它们只会收到正常关闭请求，不会被强制结束。"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="确认关闭" Click="ConfirmCommitRelief_Click" Style="{StaticResource DangerBtn}"/>
                                        <Button Content="放弃" Click="DismissCommitRelief_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}" BorderBrush="{DynamicResource WarnBg}" Background="{DynamicResource WarnBg}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AlertBannerTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource WarnFg}"/>
                                    <TextBlock Text="{Binding AlertBannerText}" TextWrapping="Wrap" Foreground="{DynamicResource WarnInk}" Margin="0,4,0,0" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="立即腾内存" Click="QuickRelief_Click" Style="{StaticResource PrimaryBtn}"/>
                                        <Button Content="忽略" Click="DismissAlert_Click" Style="{StaticResource GhostBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="时段画像" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding HabitHintText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding AiSessionText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="待处理" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="可清理候选" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnusedCandidates.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="已挂起" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SuspendedProcesses.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="未识别复核" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewQueue.Count, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Button Content="去处理 →" Click="GoClean_Click" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="快捷动作" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="回收闲置工作集" Click="TrimAllWs_Click" Style="{StaticResource PrimaryBtn}"/>
                                        <Button Content="清扫常驻垃圾" Click="SweepJunk_Click" Style="{StaticResource GhostBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 进程 ============ -->
            <TabItem Header="📋  进程" Tag="process" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="右键 = 处置 · 双击 = 定位文件" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <WrapPanel>
                            <TextBox x:Name="SearchBox" Width="200" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" Padding="6,5" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="WorkloadFilterBox" Width="104" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="按用途筛选（工作/娱乐/AI/系统/其他/未知）" SelectionChanged="WorkloadFilter_Changed">
                                <ComboBoxItem Content="全部用途" Tag=""/>
                                <ComboBoxItem Content="工作" Tag="work"/>
                                <ComboBoxItem Content="娱乐" Tag="entertainment"/>
                                <ComboBoxItem Content="AI" Tag="ai"/>
                                <ComboBoxItem Content="系统" Tag="system"/>
                                <ComboBoxItem Content="其他" Tag="other"/>
                                <ComboBoxItem Content="未知" Tag="unknown"/>
                            </ComboBox>
                            <ToggleButton x:Name="TreeModeToggle" Content="🌲 树状视图" Style="{StaticResource ToolToggle}" Checked="TreeMode_Changed" Unchecked="TreeMode_Changed" Margin="0,0,8,0"/>
                            <Button x:Name="ColumnMenuButton" Content="列设置 ▾" Style="{StaticResource ToolBtn}" Click="ColumnMenu_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Opened="ColumnMenu_Opened">
                                        <!-- Tag = 稳定 id（写进 config.json），Header = 显示文本。
                                             v0.10.0 起两者分离，否则加语言会让列设置静默重置。
                                             v0.11.0：12 项平铺 → 4 组（标识/内存/显存/证据），组头禁用项仅作标题 -->
                                        <MenuItem Header="标识" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="所属程序" Tag="program" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="窗口标题" Tag="window_title" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="厂商" Tag="vendor" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="线程数" Tag="threads" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="子进程" Tag="child_count" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="内存" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="内存增长" Tag="memory_growth" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="音频" Tag="audio" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="保护" Tag="protected" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="模式保留" Tag="mode_keep" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="显存" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="显存" Tag="gpu_memory" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="证据" IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuItem Header="签名" Tag="signature" IsCheckable="True" Click="ColumnToggle_Click"/>
                                        <MenuItem Header="分类依据" Tag="category_reason" IsCheckable="True" Click="ColumnToggle_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Rectangle Width="1" Height="22" Fill="{DynamicResource BorderBrush}" Margin="10,0" VerticalAlignment="Center"/>
                            <!-- v0.6.0：图例升级为筛选芯片（互斥；全部=清空） -->
                            <ToggleButton x:Name="ChipAll" Content="全部" Style="{StaticResource ToolToggle}" IsChecked="True" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipSystem" Content="系统·保护" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipGame" Content="游戏" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipAi" Content="AI" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click" Margin="0,0,4,0"/>
                            <ToggleButton x:Name="ChipUnknown" Content="未识别" Style="{StaticResource ToolToggle}" Click="CategoryChip_Click"/>
                        </WrapPanel>
                    </DockPanel>
                    <Grid Grid.Row="1"><DataGrid x:Name="ProcessGrid" ItemsSource="{Binding FilteredProcesses}" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="2" SelectionChanged="ProcessGrid_SelectionChanged" MouseDoubleClick="ProcessGrid_DoubleClick" Sorting="ProcessGrid_Sorting">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="SystemCritical"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="SystemService"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Driver"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="SecuritySoftware"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="AntiCheat"><Setter Property="Background" Value="{DynamicResource SystemRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Game"><Setter Property="Background" Value="{DynamicResource GameRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="GameLauncher"><Setter Property="Background" Value="{DynamicResource GameRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="AiImageVideo"><Setter Property="Background" Value="{DynamicResource AiRowBg}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource UnknownRowBg}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="处置" IsEnabled="False" FontWeight="SemiBold"/>
                                <MenuItem Header="回收工作集 (L1)" Click="CtxL1_Click"/>
                                <MenuItem Header="挂起 (L2，可恢复)" Click="CtxL2_Click"/>
                                <MenuItem Header="优雅关闭 (L3)" Click="CtxL3_Click"/>
                                <MenuItem Header="强制结束 (L4，需确认)" Click="CtxL4_Click"/>
                                <Separator/>
                                <MenuItem Header="恢复挂起" Click="CtxResumeProcess_Click"/>
                                <MenuItem Header="管理线程 (TID 级挂起/恢复)" Click="ManageThreads_Click"/>
                                <Separator/>
                                <MenuItem Header="内存策略" IsEnabled="False" FontWeight="SemiBold"/>
                                <Separator/>
                                <MenuItem Header="降低内存优先级" Click="CtxMemPriorityLow_Click"/>
                                <MenuItem Header="恢复内存优先级" Click="CtxMemPriorityNormal_Click"/>
                                <MenuItem Header="开启 EcoQoS 节能" Click="CtxEcoOn_Click"/>
                                <MenuItem Header="关闭 EcoQoS" Click="CtxEcoOff_Click"/>
                                <Separator/>
                                <MenuItem Header="标记" IsEnabled="False" FontWeight="SemiBold"/>
                                <MenuItem Header="标记用途">
                                    <MenuItem Header="工作" Tag="Work" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="娱乐" Tag="Entertainment" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="AI" Tag="Ai" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="系统" Tag="System" Click="CtxWorkload_Click"/>
                                    <MenuItem Header="其他" Tag="Other" Click="CtxWorkload_Click"/>
                                    <Separator/>
                                    <MenuItem Header="清除用途标记（回到规则判定）" Tag="" Click="CtxWorkload_Click"/>
                                </MenuItem>
                                <MenuItem Header="标记为保留（以后不清理它）" Click="CtxFeedbackKeep_Click"/>
                                <MenuItem Header="标记为可清理（优先清理它）" Click="CtxFeedbackClean_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                            <DataGridTemplateColumn Header="名称" Width="210" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="{Binding TreeDepth, Converter={StaticResource Indent}}"/>
                                            <TextBlock Text="{Binding Collapsed, Converter={StaticResource Glyph}}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="TreeToggle_MouseDown" ToolTip="点击折叠/展开子进程"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category, Converter={StaticResource CatText}}" Width="72"/>
                            <DataGridTextColumn Header="用途" Binding="{Binding Workload, Converter={StaticResource WorkloadText}}" Width="60"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="私有WS" Binding="{Binding Memory.PrivateWorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="提交" Binding="{Binding Memory.PrivateBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="CPU%" Binding="{Binding Memory.CpuPercent, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="显存" Binding="{Binding GpuMemoryText}" Width="80"/>
                            <DataGridTextColumn Header="空闲(min)" Binding="{Binding IdleMinutes, StringFormat=F0}" Width="65"/>
                            <DataGridTextColumn Header="内存增长" Binding="{Binding MemoryGrowthBytes, Converter={StaticResource SignedBytes}}" Width="85"/>
                            <DataGridTextColumn Header="子进程" Binding="{Binding ChildPids.Count}" Width="55"/>
                            <DataGridTextColumn Header="线程数" Binding="{Binding Memory.ThreadCount}" Width="55"/>
                            <DataGridTextColumn Header="所属程序" Binding="{Binding ProgramDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="厂商" Binding="{Binding Company}" Width="130"/>
                            <DataGridTextColumn Header="窗口标题" Binding="{Binding MainWindowTitle}" Width="150"/>
                            <DataGridTextColumn Header="音频" Binding="{Binding AudioActive}" Width="45"/>
                            <DataGridTextColumn Header="保护" Binding="{Binding IsProtected}" Width="45"/>
                            <DataGridTextColumn Header="模式保留" Binding="{Binding ModeKeep}" Width="60"/>
                            <DataGridTextColumn Header="签名" Binding="{Binding SignatureVerified}" Width="45"/>
                            <DataGridTextColumn Header="分类依据" Binding="{Binding CategoryReason}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <TextBlock Text="正在枚举进程（每 10 秒一次）……几秒内就会出现。列表为空且持续超过 1 分钟时，检查设置里的刷新间隔。" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"
                                   TextAlignment="Center" FontSize="12"
                                   Visibility="{Binding FilteredProcesses, Converter={StaticResource CollEmpty}}"/></Grid>
                </Grid>
            </TabItem>

            <!-- ============ 可清理 ============ -->
            <TabItem Header="🧹  可清理" Tag="cleanup" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="这些程序长期空闲：无窗口、低 CPU/IO、没在发声、也不在前台。处置前会再次确认。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CandidateRuleText}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Expander Grid.Row="1" Margin="0,0,0,6" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="{Binding ReviewQueueHeader}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </Expander.Header>
                        <StackPanel>
                            <DataGrid x:Name="ReviewGrid" ItemsSource="{Binding ReviewQueue}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="140" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="工作集" Binding="{Binding Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                                    <DataGridTextColumn Header="发布者" Binding="{Binding Company}" Width="150"/>
                                    <DataGridTextColumn Header="路径" Binding="{Binding ExecutablePath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="标记为垃圾（可清理）" Click="ReviewMarkClean_Click" Style="{StaticResource DangerBtn}"/>
                                <Button Content="标记为保留" Click="ReviewMarkKeep_Click" Style="{StaticResource PrimaryBtn}"/>
                                <Button Content="联网核实" Click="ReviewLookup_Click" Style="{StaticResource PrimaryBtn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Grid Grid.Row="2"><DataGrid x:Name="UnusedGrid" ItemsSource="{Binding UnusedCandidates}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="UnusedGrid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="L1 回收工作集（温和）" Click="CtxL1_Click"/>
                                <MenuItem Header="L2 挂起进程（可恢复）" Click="CtxL2_Click"/>
                                <MenuItem Header="L3 优雅关闭（先让它自己退出）" Click="CtxL3_Click"/>
                                <MenuItem Header="L4 强制结束（需确认）" Click="CtxL4_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Process.Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Process.Name}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Process.Category}" Width="100"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding Process.Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="预计释放(物理)" Binding="{Binding EstimatedReclaimableBytes, Converter={StaticResource Bytes}}" Width="110"/>
                            <DataGridTextColumn Header="空闲" Binding="{Binding Process.IdleMinutes, StringFormat=F0}" Width="55"/>
                            <DataGridTextColumn Header="驻留分" Binding="{Binding JunkScore, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="建议级别" Binding="{Binding SuggestedLevel}" Width="110"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding ReasonsText}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                        <TextBlock Text="当前没有可清理候选——观察期（连续 6 轮空闲观察）未满是正常的，刚启动时尤其如此。" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"
                                   TextAlignment="Center" FontSize="12"
                                   Visibility="{Binding UnusedCandidates, Converter={StaticResource CollEmpty}}"/></Grid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0">
                            <Button Content="L1 回收工作集" Click="L1_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="L2 挂起进程" Click="L2_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="L3 优雅关闭" Click="L3_Click" Style="{StaticResource PrimaryBtn}"/>
                            <Button Content="L4 强制结束（需确认）" Click="L4_Click" Style="{StaticResource DangerBtn}"/>
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                            <Menu Background="Transparent" Padding="0" Margin="0,0,10,0">
                                <MenuItem Header="批量 ▾" Padding="10,5">
                                    <MenuItem Header="全部候选 L1 回收（温和）" Click="BatchL1_Click"/>
                                    <MenuItem Header="一键清理全部候选（按建议级别，需确认）" Click="BatchSuggested_Click"/>
                                    <MenuItem Header="清扫常驻垃圾（自动识别，需确认）" Click="SweepJunk_Click"/>
                                </MenuItem>
                            </Menu>
                            <TextBlock x:Name="SelectionHint" Text="单条处置请先选择一行" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 腾内存 ============ -->
            <TabItem Header="🚀  腾内存" Tag="makeroom" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="腾内存：为 AI 生图/视频等大内存任务腾出空间" Style="{StaticResource SectionTitle}"/>
                            <!-- v0.11.0 P0-3：原先是 2 输入 + 3 复选框 + 2 标签挤一行（≈750px），1280 宽必溢出；
                                 拆成"目标 / 选项 / 动作"三行 -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="目标可用物理内存 (GB):" VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetAvailGB" Text="8" Width="60" Margin="6,0,20,0" Padding="4"/>
                                <CheckBox x:Name="EnsureCommit" Content="同时确保提交余量" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="目标提交余量 (GB):" VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetCommitGB" Text="8" Width="60" Margin="6,0,0,0" Padding="4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="AllowKill" Content="允许对无窗口进程强制结束 (L4)" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox x:Name="IncludeTrim" Content="不足部分追加回收闲置工作集" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="生成计划" Click="PlanMakeRoom_Click" Style="{StaticResource PrimaryBtn}"/>
                                <Button x:Name="ExecutePlanBtn" Content="执行计划" Click="ExecuteMakeRoom_Click" Style="{StaticResource DangerBtn}" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button x:Name="CancelPlanBtn" Content="取消执行" Click="CancelMakeRoom_Click" Style="{StaticResource PrimaryBtn}" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button Content="清空" Click="ClearMakeRoom_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="MakeRoomSummary" Text="" Margin="0,8,0,0" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MakeRoomResultText" Text="" Margin="0,4,0,0" Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="PlanGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="动作" Binding="{Binding ActionText}" Width="110"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Process.Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Process.Name}" Width="170"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Process.Category}" Width="100"/>
                            <DataGridTextColumn Header="预计释放(物理)" Binding="{Binding EstimatedPhysicalReclaimBytes, Converter={StaticResource Bytes}}" Width="120"/>
                            <DataGridTextColumn Header="预计释放(提交)" Binding="{Binding EstimatedCommitReclaimBytes, Converter={StaticResource Bytes}}" Width="120"/>
                            <DataGridTextColumn Header="子进程" Binding="{Binding ChildCount}" Width="60"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="110"/>
                            <DataGridTextColumn Header="理由" Binding="{Binding Rationale}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
