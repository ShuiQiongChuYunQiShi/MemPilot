                    <StackPanel Margin="20,18,20,20" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="阈值配置" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="未使用 CPU 阈值 (%)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetCpu" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="未使用空闲分钟数" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetIdle" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="刷新间隔 (秒)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetRefresh" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="进程最小存活期 (秒，保护刚启动的进程)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetMinAge" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="连续空闲观察轮数 (候选门槛)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetObservations" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="优雅关闭超时 (秒)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetGraceful" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自动化" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoCleanup" Content="启用模式驱动的自动清理（仅 L1 回收 / 可选 L3 优雅关闭，从不自动 L4）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoClose" Content="自动清理时允许优雅关闭（L3）" Margin="16,3"/>
                                <CheckBox x:Name="SetAutoJunkSweep" Content="自动清理垃圾驻守（无窗口/无音频的 Bloatware 与孤儿残留；最多优雅关闭，永不强制结束）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoJunkSweepOrphansOnly" Content="低风险模式：自动清扫只清「宿主已退出的孤儿残留」，不动常驻垃圾（动作为 L1 或 L3，无 L4）" Margin="16,3"/>
                                <CheckBox x:Name="SetAutoCommitRelief" Content="提交内存兜底：提交余量 &lt;5% 先清备用列表，2 分钟后仍告急才压缩「安全子集」（工作/游戏/前台/忙碌进程一律不碰）" Margin="0,3"/>
                                <CheckBox x:Name="SetCommitReliefL3" Content="提交告急时允许「征得同意后优雅关闭闲置后台」来释放提交（唯一真正有效的动作；每次都会弹窗确认，AI 会话/游戏期间不做）" Margin="16,3"/>
                                <CheckBox x:Name="SetShowAlerts" Content="重要提示触达（托盘气泡 + 主页横幅；取消勾选 = 仅写决策日志）" Margin="0,3"/>
                                <Button Content="应用低风险自动档（自动优化 + 仅清孤儿残留，清理仍只 L1）" Click="ApplyLowRiskPreset_Click" Style="{StaticResource PrimaryBtn}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="SetSkipFullscreen" Content="前台全屏（游戏）时跳过系统级清理" IsChecked="True" Margin="16,3"/>
                                <CheckBox x:Name="SetEventLog" Content="审计同步写入 Windows 事件日志（来源注册需要一次管理员运行）" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="显存采样" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetGpuSampling" Content="记录显存历史（逐进程专用/共享显存，独立落盘到 history\gpu-*.jsonl）" Margin="0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="采样间隔" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SetGpuInterval" Width="120" VerticalAlignment="Center">
                                        <ComboBoxItem Content="15 秒" Tag="15"/>
                                        <ComboBoxItem Content="30 秒（推荐）" Tag="30"/>
                                        <ComboBoxItem Content="60 秒" Tag="60"/>
                                        <ComboBoxItem Content="5 分钟" Tag="300"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="AI 生成视频时显存尖峰通常只有 1–2 分钟，30 秒采样才能留住形状；采样本身只读 PDH 计数器，不处置任何进程。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="租约 API（实验性）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetLeaseApi" Content="启用本地租约 API（只绑 127.0.0.1；AI 任务开跑前申请内存、结束归还）" Margin="0,3"/>
                                <TextBlock Text="{Binding LeaseApiStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Margin="16,2,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="端口" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SetLeasePort" Width="90" Padding="6,4" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                    <TextBlock Text="令牌" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SetLeaseToken" Width="430" IsReadOnly="True" Padding="6,4" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="重新生成" Click="RegenerateLeaseToken_Click" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="调用示例见 tools/lease-example.py；令牌重新生成后记得同步给调用方。软策略只压缩安全子集（不碰工作/游戏/前台进程），返回的是实测达成量。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="16,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="驻守" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoStart" Content="开机自启（勾选即生效）" Margin="0,3" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                <CheckBox x:Name="SetStartMinimized" Content="启动时最小化到托盘" Margin="0,3" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
                                <CheckBox x:Name="SetResumeOnModeChange" Content="模式切换时自动恢复被挂起的进程" Margin="0,3" Checked="ResumeOnChange_Changed" Unchecked="ResumeOnChange_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <CheckBox x:Name="SetHotkeyEnabled" Content="全局热键一键腾内存：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SetHotkey" Width="150" Margin="8,0,0,0" ToolTip="格式：CTRL+SHIFT+M / ALT+F9 等"/>
                                </StackPanel>
                                <TextBlock Text="热键动作：唤起主窗 → 打开腾内存页 → 按主页的目标 GB 生成计划（仍需手动确认执行）。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="程序清单" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ProgramCatalogInfo}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                <Button Content="重建程序清单（注册表 + 开始菜单 + 安装根）" Click="RebuildCatalog_Click" Style="{StaticResource PrimaryBtn}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="联网查询" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="查询端点 URL" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetEndpoint" HorizontalAlignment="Left" Width="440" Margin="0,2,0,10"/>
                                <TextBlock Text="API 密钥（仅存本机 config.json）" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetApiKey" HorizontalAlignment="Left" Width="440" Margin="0,2,0,10"/>
                                <CheckBox x:Name="SetOnlineEnabled" Content="启用联网查询" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="场景影子校准（近 7 天）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ShadowCalibrationText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StoreDiagnosticsText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button Content="刷新校准数据" Click="RefreshShadowCalibration_Click" Style="{StaticResource GhostBtn}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="名单管理" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="受保护进程" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="ProtectedListEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="白名单（不参与清理）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="WhitelistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="黑名单（观察 2 轮即可候选）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="BlacklistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock Text="所有配置保存在 %APPDATA%\MemPilot\config.json" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="控制台模式：MemPilot.exe /standbylistlowpriority | /reset" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,6">
                <ProgressBar DockPanel.Dock="Right" Width="70" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                             IsIndeterminate="True" Visibility="{Binding LongOp, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding LongOpText}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding BusyText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                <!-- v0.11.0 P0-1：状态双轨。动作反馈（60 秒保留）加粗着色显示，刷新噪音为次要段 -->
                <TextBlock Text="{Binding StatusDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActionStatus}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
