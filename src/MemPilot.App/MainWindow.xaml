                                </DockPanel>
                                <TextBlock Text="{Binding HistorySummary}" Margin="0,6,0,8" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                <Viewbox Stretch="Uniform" MaxHeight="200" HorizontalAlignment="Left" MaxWidth="900">
                                <Canvas Width="700" Height="160" Background="{DynamicResource TrackBg}" HorizontalAlignment="Left">
                                    <Line X1="0" Y1="10" X2="640" Y2="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="80" X2="640" Y2="80" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="150" X2="640" Y2="150" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="2" Text="100%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="72" Text="50%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="142" Text="0%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <Polygon Points="{Binding HistoryAreaPoints}" Fill="{DynamicResource HistoryAreaFill}"/>
                                    <Polyline Points="{Binding HistoryPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                </Canvas>
                                </Viewbox>
                                <TextBlock Text="上：24 小时内存占用率（越高越紧张；可用 GB 见上方摘要）" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="显存（每 30 秒采样，本地保存 30 天）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding GpuHistorySummary}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Viewbox Stretch="Uniform" MaxHeight="200" HorizontalAlignment="Left" MaxWidth="900">
                                <Canvas Width="700" Height="160" Background="{DynamicResource TrackBg}" HorizontalAlignment="Left">
                                    <Line X1="0" Y1="10" X2="640" Y2="10" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="80" X2="640" Y2="80" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <Line X1="0" Y1="150" X2="640" Y2="150" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="2" Text="100%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="72" Text="50%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Canvas.Left="646" Canvas.Top="142" Text="0%" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                                    <Polygon Points="{Binding GpuHistoryAreaPoints}" Fill="{DynamicResource GpuAreaFill}"/>
                                    <Polyline Points="{Binding GpuHistoryPoints}" Stroke="{DynamicResource AccentGreen}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                </Canvas>
                                </Viewbox>
                                <TextBlock Text="上：24 小时显存占用率（越高越紧张；按适配器总容量折算，采集不可用时为空）" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/>
                                <DataGrid ItemsSource="{Binding GpuUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="170"/>
                                        <DataGridTextColumn Header="峰值专用" Binding="{Binding PeakDedicatedBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="均值专用" Binding="{Binding AvgDedicatedBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="峰值共享" Binding="{Binding PeakSharedBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="出现采样" Binding="{Binding Seen}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="这张表是将来「AI 生成前申请显存、结束后归还」的验收基线：先看清谁在吃、吃多少、什么时候吃。" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                                <TextBlock Text="AI 会话段（显存 ≥8GB 且最近 5 个样本中 ≥3 个达标，单点回落不打断）" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,6"/>
                                <DataGrid ItemsSource="{Binding AiSessionItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="开始" Binding="{Binding StartText}" Width="110"/>
                                        <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="110"/>
                                        <DataGridTextColumn Header="峰值显存" Binding="{Binding PeakText}" Width="100"/>
                                        <DataGridTextColumn Header="峰值提交余量" Binding="{Binding CommitText}" Width="110"/>
                                        <DataGridTextColumn Header="主导进程" Binding="{Binding DominantText}" Width="150"/>
                                        <DataGridTextColumn Header="PID 数" Binding="{Binding PidCount}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="模式使用时长（7 天）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ModeUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="模式 / 时长" Binding="{Binding Display}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="动作计数（7 天，来自审计）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ActionUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="吃内存大户（24 小时均值 Top12）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding TopUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="170"/>
                                        <DataGridTextColumn Header="平均私有WS" Binding="{Binding AvgWsMb, StringFormat={}{0:F0} MB}" Width="110"/>
                                        <DataGridTextColumn Header="峰值" Binding="{Binding MaxWsMb, StringFormat={}{0:F0} MB}" Width="100"/>
                                        <DataGridTextColumn Header="平均CPU%" Binding="{Binding AvgCpu}" Width="90"/>
                                        <DataGridTextColumn Header="平均线程" Binding="{Binding Threads, StringFormat=F0}" Width="90"/>
                                        <DataGridTextColumn Header="出现采样" Binding="{Binding Seen}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="这些数据也是将来 AI 功能（习惯学习、腾内存预测、异常检测）的训练地基。" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 操作审计 ============ -->
            <TabItem Header="📜  操作审计" Tag="audit" Style="{StaticResource NavTab}">
                <Grid><DataGrid Margin="14,14,14,0" ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="160"/>
                        <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="200"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="160"/>
                        <DataGridTextColumn Header="清理前" Binding="{Binding MemoryBeforeBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridTextColumn Header="清理后" Binding="{Binding MemoryAfterBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                        <TextBlock Text="还没有操作记录。手动处置或自动清理后，这里会有每次动作的实测前后值。" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"
                                   TextAlignment="Center" FontSize="12"
                                   Visibility="{Binding AuditEntries, Converter={StaticResource CollEmpty}}"/></Grid>
            </TabItem>

            <!-- ============ 模式 ============ -->
            
            <TextBlock Text="高级" Style="{StaticResource NavGroup}"/>
            <TabItem Header="💬  反馈记录" Tag="feedback" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding FeedbackEntries.Count, StringFormat=已记录 {0} 条 · 右键行可撤销}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Text="在「进程」页右键进程即可标记（保留 / 可清理 / 系统 / 用途）；本页只做查看与撤销，数据只存本机。"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="FeedbackGrid" ItemsSource="{Binding FeedbackEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="撤销这条反馈（删除标记）" Click="DeleteFeedback_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="100"/>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding ReportedCategory, Converter={StaticResource CatText}}" Width="120"/>
                            <DataGridTextColumn Header="效果" Binding="{Binding EffectText}" Width="160"/>
                            <DataGridTextColumn Header="用途" Binding="{Binding WorkloadMarkText}" Width="60"/>
                            <DataGridTextColumn Header="范围" Binding="{Binding ScopeText}" Width="60"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding UserNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="🎚️  模式" Tag="mode" Style="{StaticResource NavTab}">
                <!-- v0.11.0：标题移到页首（原来在第一张卡片下面，顺序倒置）；整页包 ScrollViewer（矮窗口时下半页不可达） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="14,14,14,14">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="场景模式与规则" Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="场景识别（影子模式：只判定、不切换）" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding SceneSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="娱乐" Style="{StaticResource CaptionText}"/>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding SceneGame, Mode=OneWay}" Maximum="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="AI 生成" Style="{StaticResource CaptionText}"/>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding SceneAi, Mode=OneWay}" Maximum="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="开发" Style="{StaticResource CaptionText}"/>
                                        <ProgressBar Style="{StaticResource MemBar}" Value="{Binding SceneDev, Mode=OneWay}" Maximum="100"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SceneReason}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="ModeList" Height="200" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="ModeList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="应用选中模式" Click="ApplyMode_Click" Style="{StaticResource PrimaryBtn}"/>
                        </StackPanel>
                        <TextBlock Text="编辑选中模式的规则（每行一个关键词，匹配进程名或路径）：" Margin="0,14,0,4" Foreground="{DynamicResource TextPrimary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="保留名单（保留，不参与自动清理）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="KeepPatternsEditor" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="清理名单（自动清理的作用范围）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="CleanPatternsEditor" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存该模式规则" Click="SaveModeRules_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock x:Name="ModeEditorHint" Text="（选中上方模式后编辑）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Text="模式配置保存在 config.json；自动切换带滞回（连续两轮确认 + 60 秒冷却）。" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            </TabItem>
            <!-- ============ 系统内存清理 ============ -->
            <TabItem Header="🧼  系统内存清理" Tag="sysmem" Style="{StaticResource NavTab}">
                <ScrollViewer Margin="14,14,14,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="系统内存区域清理（需要管理员权限）" Style="{StaticResource PageTitle}"/>
