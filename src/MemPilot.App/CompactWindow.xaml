<Window x:Class="MemPilot.App.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Mini_Title}" Height="96" Width="352"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Icon="app.ico" MouseLeftButtonDown="Compact_Drag">
    <Border CornerRadius="12" Background="#F0111827" BorderBrush="#334155" BorderThickness="1" Padding="14,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding UsedPercentText}" FontSize="26" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MemBar}" Value="{Binding UsedPercent, Mode=OneWay}" Height="8"/>
                    <TextBlock Text="{Binding AvailableMemoryText, StringFormat=可用 {0}}" FontSize="10" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✕" Click="CompactClose_Click" Style="{StaticResource GhostBtn}" ToolTip="{DynamicResource Mini_Collapse}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Mini_Optimize}" Click="CompactOptimize_Click" Style="{StaticResource GhostBtn}"/>
                <Button Grid.Column="1" Content="{DynamicResource Concept_MakeRoom}" Click="CompactMakeRoom_Click" Style="{StaticResource GhostBtn}"/>
                <Button Grid.Column="2" Content="{DynamicResource Mini_MainWindow}" Click="CompactMain_Click" Style="{StaticResource GhostBtn}"/>
                <TextBlock Grid.Column="3" x:Name="CompactStatus" Text="{Binding CurrentModeText}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</Window>
