<Window x:Class="MemoryTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:MemoryTool.Helpers"
        mc:Ignorable="d"
        Title="MemoryTool - 内存与进程管家" Height="780" Width="1280" Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBg}"
        FontFamily="Microsoft YaHei UI,Segoe UI">
    <Window.Resources>
        <helpers:ByteSizeConverter x:Key="Bytes"/>
        <helpers:SignedBytesConverter x:Key="SignedBytes"/>

        <!-- sidebar tab -->
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="10,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shell -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="208"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0F172A">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="18,18,18,14">
                                        <TextBlock Text="MemoryTool" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="内存与进程管家" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                                        <TextBlock Text="{Binding UsedPercentText, StringFormat=内存 {0}}" Foreground="#94A3B8" FontSize="12"/>
                                        <TextBlock Text="{Binding UsedDetailText}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AppVersionText}" Foreground="#475569" FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,4,0,0"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <DockPanel Grid.Column="1">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12,14,0">
                                    <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="迷你条" Click="Compact_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="最小化到托盘" Click="ToTray_Click" Style="{StaticResource GhostBtn}"/>
                                    <Button Content="切换主题" Click="ToggleTheme_Click" Style="{StaticResource GhostBtn}"/>
                                </StackPanel>
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- cards & buttons -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="ModeChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource ChipBg}" CornerRadius="10" Padding="16,9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MemBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource TrackBg}" CornerRadius="7">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" Background="#2563EB" CornerRadius="7" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#374151"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAltBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DgHeader}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="RootTabs" Grid.Row="0" SelectionChanged="TabControl_SelectionChanged">

            <!-- ============ 主页 ============ -->
            <TabItem Header="🏠  主页" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,20" MaxWidth="1000" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="这个工具帮你做什么？" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                           Text="找出你「没在用」的程序（没有窗口、几乎不吃 CPU、没在发声、也不在前台），然后按需腾出内存——最典型的场景：跑 AI 生图/生视频之前，把内存让出来。系统的、杀毒的、反作弊的、你正在用的，它都不会碰；自动动作永远不强杀进程，每一个决定都记录在「决策日志」里，随时可以查为什么。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="内存占用" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UsedPercentText}" FontSize="52" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding UsedDetailText}" VerticalAlignment="Bottom" Margin="10,0,0,10" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource MemBar}" Value="{Binding UsedPercent, Mode=OneWay}" Width="440" HorizontalAlignment="Left" Margin="0,4,0,10"/>
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12">
                                        <Run Text="可用 "/><Run Text="{Binding AvailableMemoryText, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="    提交 "/><Run Text="{Binding CommitText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Width="270" Margin="20,0,0,0">
                                    <TextBlock Text="GPU 显存" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                    <TextBlock Text="{Binding GpuSummaryText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,12"/>
                                    <TextBlock Text="可用内存趋势" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    <Canvas Width="260" Height="64" Background="{DynamicResource TrackBg}" Margin="0,4,0,0">
                                        <Polygon Points="{Binding MemoryTrendAreaPoints}" Fill="#332563EB"/>
                                        <Polyline Points="{Binding MemoryTrendPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="现在在做什么？选一个场景，自动清理的范围随之改变" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <UniformGrid Columns="5" Margin="0,12,0,4">
                                    <RadioButton x:Name="ModeRbResident" Content="🛡️ 驻守" GroupName="HomeMode" Tag="Resident" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                    <RadioButton x:Name="ModeRbDevelopment" Content="💻 开发" GroupName="HomeMode" Tag="Development" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                    <RadioButton x:Name="ModeRbGame" Content="🎮 游戏" GroupName="HomeMode" Tag="Game" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                    <RadioButton x:Name="ModeRbAiGeneration" Content="🤖 AI 生成" GroupName="HomeMode" Tag="AiGeneration" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                    <RadioButton x:Name="ModeRbBalanced" Content="⚖️ 平衡" GroupName="HomeMode" Tag="Balanced" Style="{StaticResource ModeChip}" Checked="HomeMode_Checked"/>
                                </UniformGrid>
                                <TextBlock Text="{Binding ModeDescription}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="2,0,0,6" TextWrapping="Wrap"/>
                                <CheckBox x:Name="AutoSwitchCheck" Content="自动切换：全屏游戏→游戏模式，AI 工具常驻→AI 模式，前台 IDE→开发模式（带滞回，切换会通知）"
                                          Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,14">
                                <StackPanel>
                                    <TextBlock Text="🤖 要跑 AI 生图 / 生视频了？" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="告诉它需要多少 GB，它会列出可以关闭的程序让你确认，绝不会自作主张强杀。" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="需要" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBox x:Name="HomeTargetGB" Text="8" Width="56" Margin="6,0" Padding="6,4" VerticalAlignment="Center"/>
                                        <TextBlock Text="GB 可用内存" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimary}"/>
                                        <Button Content="生成腾挪计划 →" Click="HomePlan_Click" Style="{StaticResource PrimaryBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="🧹 日常维护" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,10">
                                        可清理候选 <Run Text="{Binding UnusedCandidates.Count, Mode=OneWay}" FontWeight="Bold"/><Run Text=" 个 · 已挂起 "/><Run Text="{Binding SuspendedProcesses.Count, Mode=OneWay}" FontWeight="Bold"/><Run Text=" 个"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="一键优化（温和回收）" Click="Optimize_Click" Style="{StaticResource PrimaryBtn}"/>
                                        <Button Content="查看可清理 →" Click="GoClean_Click" Style="{StaticResource LinkBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="全部记录 →" Click="GoDecisions_Click" Style="{StaticResource LinkBtn}"/>
                                    <TextBlock Text="引擎最近在做什么" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding HomeDecisions}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,3" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#94A3B8"/>
                                                <Run Text="{Binding LineText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="（还没有自动动作记录——开启自动切换或自动清理后，这里会显示引擎的每个决定和原因）"
                                           Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="谁在占内存（按分类汇总）" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程组" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="80"/>
                                        <DataGridTextColumn Header="工作集" Binding="{Binding TotalWorkingSetBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                        <DataGridTextColumn Header="提交" Binding="{Binding TotalCommitBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 进程 ============ -->
            <TabItem Header="📋  进程" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Width="280" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" Padding="6,4"/>
                        <TextBlock Text="按名称 / 路径 / 窗口标题搜索；右键进程可挂起、关闭、降权或标记保留" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <DataGrid x:Name="ProcessGrid" Grid.Row="1" ItemsSource="{Binding FilteredProcesses}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ProcessGrid_SelectionChanged" MouseDoubleClick="ProcessGrid_DoubleClick">
                        <DataGrid.ToolTip>双击某行：在资源管理器中定位该程序的文件</DataGrid.ToolTip>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="L1 回收工作集（温和）" Click="CtxL1_Click"/>
                                <MenuItem Header="L2 挂起进程（可恢复）" Click="CtxL2_Click"/>
                                <MenuItem Header="L3 优雅关闭（先让它自己退出）" Click="CtxL3_Click"/>
                                <MenuItem Header="L4 强制结束（需确认）" Click="CtxL4_Click"/>
                                <Separator/>
                                <MenuItem Header="恢复挂起" Click="CtxResumeProcess_Click"/>
                                <Separator/>
                                <MenuItem Header="降低内存优先级" Click="CtxMemPriorityLow_Click"/>
                                <MenuItem Header="恢复内存优先级" Click="CtxMemPriorityNormal_Click"/>
                                <MenuItem Header="开启 EcoQoS 节能" Click="CtxEcoOn_Click"/>
                                <MenuItem Header="关闭 EcoQoS" Click="CtxEcoOff_Click"/>
                                <Separator/>
                                <MenuItem Header="标记为需保留（以后不清理它）" Click="CtxFeedbackKeep_Click"/>
                                <MenuItem Header="标记为可清理（优先清理它）" Click="CtxFeedbackClean_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="私有WS" Binding="{Binding Memory.PrivateWorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="提交" Binding="{Binding Memory.PrivateBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="CPU%" Binding="{Binding Memory.CpuPercent, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="空闲(min)" Binding="{Binding IdleMinutes, StringFormat=F0}" Width="65"/>
                            <DataGridTextColumn Header="内存增长" Binding="{Binding MemoryGrowthBytes, Converter={StaticResource SignedBytes}}" Width="85"/>
                            <DataGridTextColumn Header="子进程" Binding="{Binding ChildPids.Count}" Width="55"/>
                            <DataGridTextColumn Header="线程" Binding="{Binding Memory.ThreadCount}" Width="50"/>
                            <DataGridTextColumn Header="厂商" Binding="{Binding Company}" Width="130"/>
                            <DataGridTextColumn Header="窗口标题" Binding="{Binding MainWindowTitle}" Width="150"/>
                            <DataGridTextColumn Header="音频" Binding="{Binding AudioActive}" Width="45"/>
                            <DataGridTextColumn Header="保护" Binding="{Binding IsProtected}" Width="45"/>
                            <DataGridTextColumn Header="模式保留" Binding="{Binding ModeKeep}" Width="60"/>
                            <DataGridTextColumn Header="签名" Binding="{Binding SignatureVerified}" Width="45"/>
                            <DataGridTextColumn Header="分类依据" Binding="{Binding CategoryReason}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============ 可清理 ============ -->
            <TabItem Header="🧹  可清理" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="这些程序长期空闲：无窗口、低 CPU/IO、没在发声、也不在前台。处置前会再次确认。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CandidateRuleText}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="UnusedGrid" Grid.Row="1" ItemsSource="{Binding UnusedCandidates}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="UnusedGrid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="L1 回收工作集（温和）" Click="CtxL1_Click"/>
                                <MenuItem Header="L2 挂起进程（可恢复）" Click="CtxL2_Click"/>
                                <MenuItem Header="L3 优雅关闭（先让它自己退出）" Click="CtxL3_Click"/>
                                <MenuItem Header="L4 强制结束（需确认）" Click="CtxL4_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Process.Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Process.Name}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Process.Category}" Width="100"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding Process.Memory.WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90"/>
                            <DataGridTextColumn Header="预计释放(物理)" Binding="{Binding EstimatedReclaimableBytes, Converter={StaticResource Bytes}}" Width="110"/>
                            <DataGridTextColumn Header="预计释放(提交)" Binding="{Binding EstimatedCommitReclaimableBytes, Converter={StaticResource Bytes}}" Width="110"/>
                            <DataGridTextColumn Header="空闲" Binding="{Binding Process.IdleMinutes, StringFormat=F0}" Width="55"/>
                            <DataGridTextColumn Header="风险" Binding="{Binding Risk}" Width="70"/>
                            <DataGridTextColumn Header="建议级别" Binding="{Binding SuggestedLevel}" Width="110"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding ReasonsText}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="L1 回收工作集" Click="L1_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="L2 挂起进程" Click="L2_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="L3 优雅关闭" Click="L3_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="L4 强制结束（需确认）" Click="L4_Click" Style="{StaticResource DangerBtn}"/>
                        <TextBlock x:Name="SelectionHint" Text="请先选择一行" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 腾内存 ============ -->
            <TabItem Header="🚀  腾内存" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="腾内存：为 AI 生图/视频等大内存任务腾出空间" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="目标可用物理内存 (GB):" VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetAvailGB" Text="8" Width="60" Margin="6,0,16,0" Padding="4"/>
                                <CheckBox x:Name="EnsureCommit" Content="同时确保提交内存" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="目标提交空闲 (GB):" VerticalAlignment="Center"/>
                                <TextBox x:Name="TargetCommitGB" Text="8" Width="60" Margin="6,0,16,0" Padding="4"/>
                                <CheckBox x:Name="AllowKill" Content="允许对无窗口进程强制结束（L4）" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="IncludeTrim" Content="不足部分追加工作集回收" IsChecked="True" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="① 生成计划" Click="PlanMakeRoom_Click" Style="{StaticResource PrimaryBtn}"/>
                                <Button x:Name="ExecutePlanBtn" Content="② 执行计划" Click="ExecuteMakeRoom_Click" Style="{StaticResource DangerBtn}" IsEnabled="False"/>
                                <Button x:Name="CancelPlanBtn" Content="取消执行" Click="CancelMakeRoom_Click" Style="{StaticResource PrimaryBtn}" IsEnabled="False"/>
                                <Button Content="清空" Click="ClearMakeRoom_Click" Style="{StaticResource PrimaryBtn}"/>
                                <TextBlock x:Name="MakeRoomSummary" Text="" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="MakeRoomResultText" Text="" Margin="0,8,0,0" Foreground="{DynamicResource AccentGreen}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="PlanGrid" Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="动作" Binding="{Binding ActionText}" Width="110"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Process.Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Process.Name}" Width="170"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Process.Category}" Width="100"/>
                            <DataGridTextColumn Header="预计释放(物理)" Binding="{Binding EstimatedPhysicalReclaimBytes, Converter={StaticResource Bytes}}" Width="120"/>
                            <DataGridTextColumn Header="预计释放(提交)" Binding="{Binding EstimatedCommitReclaimBytes, Converter={StaticResource Bytes}}" Width="120"/>
                            <DataGridTextColumn Header="子进程" Binding="{Binding ChildCount}" Width="60"/>
                            <DataGridTextColumn Header="理由" Binding="{Binding Rationale}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="说明：L3 会先发送 WM_CLOSE 让程序自行退出，超时后按选项决定是否升级为 L4；计划不会包含系统、杀毒、反作弊、未识别分类，以及正在发声、前台、刚启动的进程。" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- ============ 挂起/处置 ============ -->
            <TabItem Header="⏸️  挂起/处置" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="被本工具挂起的进程（挂起只冻结 CPU，不释放内存；请记得恢复）" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}"/>
                    <ListBox x:Name="SuspendedList" Grid.Row="1" ItemsSource="{Binding SuspendedProcesses}"/>
                    <TextBlock Grid.Row="2" Text="最近被本工具关闭/结束的程序（记录 exe 路径，可一键重新启动）" Margin="0,10,0,8" Foreground="{DynamicResource TextSecondary}"/>
                    <DataGrid x:Name="DisposalsGrid" Grid.Row="3" ItemsSource="{Binding DisposalRecords}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="150"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170"/>
                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="130"/>
                            <DataGridTextColumn Header="已退出" Binding="{Binding Exited}" Width="60"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding ExePath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="恢复选中挂起" Click="ResumeSelected_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="恢复全部挂起" Click="ResumeAll_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="重启选中程序" Click="RestartDisposal_Click" Style="{StaticResource PrimaryBtn}" Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 决策日志 ============ -->
            <TabItem Header="🧠  决策日志" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="引擎的每个自动决定：为什么切换模式、执行/跳过了谁、跳过原因（自动行为可解释）" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DecisionEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="150"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="110"/>
                            <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="220"/>
                            <DataGridTextColumn Header="决定" Binding="{Binding Decision}" Width="130"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============ 历史 ============ -->
            <TabItem Header="📊  历史" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,14,14,20" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新统计" Click="LoadHistory_Click" Style="{StaticResource PrimaryBtn}"/>
                                    <TextBlock Text="使用习惯记录（每 5 分钟一个采样点，本地保存 30 天）" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding HistorySummary}" Margin="0,6,0,8" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                <Canvas Width="640" Height="160" Background="{DynamicResource TrackBg}" HorizontalAlignment="Left">
                                    <Polygon Points="{Binding HistoryAreaPoints}" Fill="#332563EB"/>
                                    <Polyline Points="{Binding HistoryPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                </Canvas>
                                <TextBlock Text="上：24 小时可用内存占比（越低越紧张）" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="模式使用时长（7 天）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ModeUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="模式 / 时长" Binding="{Binding Display}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="动作计数（7 天，来自审计）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding ActionUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="吃内存大户（24 小时均值 Top12）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding TopUsageItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="170"/>
                                        <DataGridTextColumn Header="平均私有WS" Binding="{Binding AvgWsMb, StringFormat={}{0:F0} MB}" Width="110"/>
                                        <DataGridTextColumn Header="峰值" Binding="{Binding MaxWsMb, StringFormat={}{0:F0} MB}" Width="100"/>
                                        <DataGridTextColumn Header="平均CPU%" Binding="{Binding AvgCpu}" Width="90"/>
                                        <DataGridTextColumn Header="平均线程" Binding="{Binding Threads, StringFormat=F0}" Width="90"/>
                                        <DataGridTextColumn Header="出现采样" Binding="{Binding Seen}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="这些数据也是将来 AI 功能（习惯学习、腾挪预测、异常检测）的训练地基。" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 操作审计 ============ -->
            <TabItem Header="📜  操作审计" Style="{StaticResource NavTab}">
                <DataGrid Margin="14,14,14,0" ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="160"/>
                        <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="200"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="160"/>
                        <DataGridTextColumn Header="清理前" Binding="{Binding MemoryBeforeBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridTextColumn Header="清理后" Binding="{Binding MemoryAfterBytes, Converter={StaticResource Bytes}}" Width="90"/>
                        <DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ============ 线程 ============ -->
            <TabItem Header="🧵  线程" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="ThreadSearchBox" Width="260" Margin="0,0,8,0" Padding="6,4" KeyUp="ThreadSearch_KeyUp"/>
                        <TextBlock Text="按 PID 或 TID 过滤（回车应用）" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="ThreadGrid" ItemsSource="{Binding Threads}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="挂起线程" Click="CtxSuspendThread_Click"/>
                                <MenuItem Header="恢复线程" Click="CtxResumeThread_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding OwnerPid}" Width="60"/>
                            <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="70"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="等待原因" Binding="{Binding WaitReason}" Width="120"/>
                            <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                            <DataGridTextColumn Header="CPU 时间" Binding="{Binding TotalCpuTime}" Width="100"/>
                            <DataGridTextColumn Header="启动时间" Binding="{Binding StartTime}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============ 模式 ============ -->
            <TabItem Header="🎚️  模式" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="场景模式与规则" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <ListBox x:Name="ModeList" Height="200" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="ModeList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="应用选中模式" Click="ApplyMode_Click" Style="{StaticResource PrimaryBtn}"/>
                        </StackPanel>
                        <TextBlock Text="编辑选中模式的规则（每行一个关键词，匹配进程名或路径）：" Margin="0,14,0,4" Foreground="{DynamicResource TextPrimary}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="KeepPatterns（保留，不参与自动清理）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="KeepPatternsEditor" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CleanPatterns（清理名单，自动清理的作用范围）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="CleanPatternsEditor" Height="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存该模式规则" Click="SaveModeRules_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock x:Name="ModeEditorHint" Text="（选中上方模式后编辑）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Text="模式配置保存在 config.json；自动切换带滞回（连续两轮确认 + 60 秒冷却）。" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 反馈 ============ -->
            <TabItem Header="💬  反馈" Style="{StaticResource NavTab}">
                <Grid Margin="14,14,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="教它认识进程：最方便的方式是在「进程」页右键某个进程直接标记；这里也可以手工提交。" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="FbName" Width="160" Margin="0,0,8,0" ToolTip="进程名" Padding="6,4"/>
                        <TextBox x:Name="FbPath" Width="260" Margin="0,0,8,0" ToolTip="可执行文件路径" Padding="6,4"/>
                        <ComboBox x:Name="FbCategory" Width="160" Margin="0,0,8,0"/>
                        <TextBox x:Name="FbNote" Width="200" Margin="0,0,8,0" ToolTip="备注" Padding="6,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FeedbackEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="160"/>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="130"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding ReportedCategory}" Width="110"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="70"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding UserNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="提交反馈" Click="SubmitFeedback_Click" Style="{StaticResource PrimaryBtn}"/>
                        <CheckBox x:Name="FbKeep" Content="标记需保留" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FbClean" Content="标记可清理" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FbSystem" Content="标记为系统进程" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ 系统内存清理 ============ -->
            <TabItem Header="🧼  系统内存清理" Style="{StaticResource NavTab}">
                <ScrollViewer Margin="14,14,14,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="系统内存区域清理（需要管理员权限）" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="注意：完整清理备用列表会让游戏重新读盘造成卡顿；游戏运行时建议只使用低优先级备用列表。" Foreground="{DynamicResource AccentRed}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <CheckBox x:Name="ChkCombinedPageList" Content="Combined Page List（合并页列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkModifiedFileCache" Content="Modified File Cache（修改的文件缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkModifiedPageList" Content="Modified Page List（修改的页列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkRegistryCache" Content="Registry Cache（注册表缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkStandbyList" Content="Standby List（备用列表 - 完整，游戏运行时慎用）" Margin="0,4"/>
                        <CheckBox x:Name="ChkStandbyListLow" Content="Standby List (Low Priority)（低优先级备用列表 - 推荐）" Margin="0,4"/>
                        <CheckBox x:Name="ChkSystemFileCache" Content="System File Cache（系统文件缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkWorkingSet" Content="Working Set（工作集 - 所有进程）" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="清理选中区域" Click="CleanMemoryAreas_Click" Style="{StaticResource DangerBtn}"/>
                            <Button Content="全选" Click="SelectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                            <Button Content="取消全选" Click="DeselectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="CleanResultText" Text="" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 设置 ============ -->
            <TabItem Header="⚙️  设置" Style="{StaticResource NavTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,20" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="阈值配置" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="未使用 CPU 阈值 (%)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetCpu" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="未使用空闲分钟数" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetIdle" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="刷新间隔 (秒)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetRefresh" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="进程最小存活期 (秒，保护刚启动的进程)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetMinAge" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="连续空闲观察轮数 (候选门槛)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetObservations" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                        <TextBlock Text="优雅关闭超时 (秒)" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="SetGraceful" Width="120" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自动化" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoCleanup" Content="启用模式驱动的自动清理（仅 L1 回收 / 可选 L3 优雅关闭，从不自动 L4）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoClose" Content="自动清理时允许优雅关闭（L3）" Margin="16,3"/>
                                <CheckBox x:Name="SetAutoOptimize" Content="启用系统内存自动优化（低内存时清理低优先级备用列表）" Margin="0,3"/>
                                <CheckBox x:Name="SetAutoOptimizeInterval" Content="另按固定周期清理（不推荐，可能影响游戏）" Margin="16,3"/>
                                <CheckBox x:Name="SetSkipFullscreen" Content="前台全屏（游戏）时跳过系统级清理" IsChecked="True" Margin="16,3"/>
                                <CheckBox x:Name="SetEventLog" Content="审计同步写入 Windows 事件日志（来源注册需要一次管理员运行）" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="驻守" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SetAutoStart" Content="开机自启（勾选即生效）" Margin="0,3" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                                <CheckBox x:Name="SetStartMinimized" Content="启动时最小化到托盘" Margin="0,3" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
                                <CheckBox x:Name="SetResumeOnModeChange" Content="模式切换时自动恢复被挂起的进程" Margin="0,3" Checked="ResumeOnChange_Changed" Unchecked="ResumeOnChange_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <CheckBox x:Name="SetHotkeyEnabled" Content="全局热键一键腾内存：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SetHotkey" Width="150" Margin="8,0,0,0" ToolTip="格式：CTRL+SHIFT+M / ALT+F9 等"/>
                                </StackPanel>
                                <TextBlock Text="热键动作：唤起主窗 → 打开腾内存页 → 按主页的目标 GB 生成计划（仍需手动确认执行）。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="20,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="联网查询" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <TextBlock Text="查询端点 URL" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetEndpoint" Width="440" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                <TextBlock Text="API 密钥（仅存本机 config.json）" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SetApiKey" Width="440" HorizontalAlignment="Left" Margin="0,2,0,10"/>
                                <CheckBox x:Name="SetOnlineEnabled" Content="启用联网查询" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="名单管理" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="受保护进程" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="ProtectedListEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="白名单（不参与清理）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="WhitelistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="黑名单（观察 2 轮即可候选）" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox x:Name="BlacklistEditor" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource PrimaryBtn}"/>
                            <TextBlock Text="所有配置保存在 %APPDATA%\MemoryTool\config.json" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="控制台模式：MemoryTool.exe /standbylistlowpriority | /reset" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1" Background="{DynamicResource RowAltBg}">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextPrimary}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextSecondary}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
