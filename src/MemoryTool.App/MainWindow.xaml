<Window x:Class="MemoryTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemoryTool.App"
        mc:Ignorable="d"
        Title="MemoryTool - 常驻内存与进程/线程管理器" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7"
        FontFamily="Microsoft YaHei UI,Segoe UI">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#374151"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DgHeader}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" Padding="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MemoryTool" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="  常驻内存与进程/线程管理器" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock Text="场景模式：" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ModeCombo" Width="170" Margin="0,0,8,0" SelectionChanged="ModeCombo_SelectionChanged" Background="White"/>
                    <Button Content="刷新" Click="Refresh_Click" Style="{StaticResource PrimaryBtn}"/>
                    <Button Content="一键优化" Click="Optimize_Click" Style="{StaticResource PrimaryBtn}"/>
                    <Button Content="批量 L4 清理" Click="BatchL4_Click" Style="{StaticResource DangerBtn}"/>
                    <Button Content="最小化到托盘" Click="ToTray_Click" Style="{StaticResource PrimaryBtn}"/>
                    <Button Content="切换主题" Click="ToggleTheme_Click" Style="{StaticResource PrimaryBtn}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="6" Background="Transparent">
            <TabItem Header="概览">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource Card}" Width="170">
                            <StackPanel>
                                <TextBlock Text="物理内存总量" Foreground="#6B7280" FontSize="11"/>
                                <TextBlock Text="{Binding TotalMemoryText}" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="170">
                            <StackPanel>
                                <TextBlock Text="可用内存" Foreground="#6B7280" FontSize="11"/>
                                <TextBlock Text="{Binding AvailableMemoryText}" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="170">
                            <StackPanel>
                                <TextBlock Text="提交内存" Foreground="#6B7280" FontSize="11"/>
                                <TextBlock Text="{Binding CommitText}" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="170">
                            <StackPanel>
                                <TextBlock Text="当前模式" Foreground="#6B7280" FontSize="11"/>
                                <TextBlock Text="{Binding CurrentModeText}" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="170">
                            <StackPanel>
                                <TextBlock Text="进程数" Foreground="#6B7280" FontSize="11"/>
                                <TextBlock Text="{Binding Processes.Count}" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="170">
                            <StackPanel>
                                <TextBlock Text="可清理候选" Foreground="#6B7280" FontSize="11"/>
                                <TextBlock Text="{Binding UnusedCandidates.Count}" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Height="100">
                        <StackPanel>
                            <TextBlock Text="可用内存趋势" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <Canvas Width="300" Height="80" Background="#F8FAFC">
                                <Polyline Points="{Binding MemoryTrendPoints}" Stroke="{DynamicResource AccentBlue}" StrokeThickness="2"/>
                            </Canvas>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程组" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="80"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding TotalWorkingSetBytes}" Width="120"/>
                            <DataGridTextColumn Header="私有字节" Binding="{Binding TotalPrivateBytes}" Width="120"/>
                            <DataGridTextColumn Header="提交大小" Binding="{Binding TotalCommitBytes}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="进程">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Width="280" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged" Padding="6,4"/>
                        <TextBlock Text="按名称/路径/窗口标题搜索" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredProcesses}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="L1 回收工作集" Click="CtxL1_Click"/>
                                <MenuItem Header="L2 挂起进程" Click="CtxL2_Click"/>
                                <MenuItem Header="L4 强制结束" Click="CtxL4_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding Memory.WorkingSetBytes}" Width="90"/>
                            <DataGridTextColumn Header="私有" Binding="{Binding Memory.PrivateBytes}" Width="90"/>
                            <DataGridTextColumn Header="提交" Binding="{Binding Memory.CommitBytes}" Width="90"/>
                            <DataGridTextColumn Header="CPU%" Binding="{Binding Memory.CpuPercent, StringFormat=F1}" Width="55"/>
                            <DataGridTextColumn Header="线程" Binding="{Binding Memory.ThreadCount}" Width="50"/>
                            <DataGridTextColumn Header="厂商" Binding="{Binding Company}" Width="130"/>
                            <DataGridTextColumn Header="窗口标题" Binding="{Binding MainWindowTitle}" Width="150"/>
                            <DataGridTextColumn Header="保护" Binding="{Binding IsProtected}" Width="50"/>
                            <DataGridTextColumn Header="分类依据" Binding="{Binding CategoryReason}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="未使用/清理">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="可清理候选（无窗口、低 CPU、空闲、无子进程、非服务）" Margin="0,0,0,8" Foreground="#374151"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UnusedCandidates}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="L1 回收工作集" Click="CtxL1_Click"/>
                                <MenuItem Header="L2 挂起进程" Click="CtxL2_Click"/>
                                <MenuItem Header="L4 强制结束" Click="CtxL4_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Process.Pid}" Width="60"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Process.Name}" Width="150"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding Process.Category}" Width="100"/>
                            <DataGridTextColumn Header="工作集" Binding="{Binding Process.Memory.WorkingSetBytes}" Width="90"/>
                            <DataGridTextColumn Header="预计释放" Binding="{Binding EstimatedReclaimableBytes}" Width="95"/>
                            <DataGridTextColumn Header="风险" Binding="{Binding Risk}" Width="70"/>
                            <DataGridTextColumn Header="建议级别" Binding="{Binding SuggestedLevel}" Width="100"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding ReasonsText}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="L1 回收工作集" Click="L1_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="L2 挂起进程" Click="L2_Click" Style="{StaticResource PrimaryBtn}"/>
                        <Button Content="L4 强制结束（需确认）" Click="L4_Click" Style="{StaticResource DangerBtn}"/>
                        <TextBlock Text="请先选择一行" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="线程">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="ThreadSearchBox" Width="260" Margin="0,0,8,0" Padding="6,4"/>
                        <TextBlock Text="按 PID 或进程名搜索" VerticalAlignment="Center" Foreground="Gray"/>
                        <Button Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" Padding="6,2"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="ThreadGrid" ItemsSource="{Binding Threads}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="挂起线程" Click="CtxSuspendThread_Click"/>
                                <MenuItem Header="恢复线程" Click="CtxResumeThread_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding OwnerPid}" Width="60"/>
                            <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="70"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="等待原因" Binding="{Binding WaitReason}" Width="120"/>
                            <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                            <DataGridTextColumn Header="CPU 时间" Binding="{Binding TotalCpuTime}" Width="100"/>
                            <DataGridTextColumn Header="启动时间" Binding="{Binding StartTime}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="模式">
                <Grid Margin="4">
                    <StackPanel>
                        <TextBlock Text="场景模式" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#111827"/>
                        <ListBox x:Name="ModeList" Height="220" BorderBrush="#DCE1E6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="应用模式" Click="ApplyMode_Click" Style="{StaticResource PrimaryBtn}"/>
                            <CheckBox x:Name="AutoSwitchCheck" Content="按前台进程自动切换" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="模式配置保存在 config.json" Margin="0,8,0,0" Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="审计日志">
                <DataGrid Margin="4" ItemsSource="{Binding AuditEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="160"/>
                        <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="90"/>
                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="190"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="110"/>
                        <DataGridTextColumn Header="清理前内存" Binding="{Binding MemoryBeforeBytes}" Width="95"/>
                        <DataGridTextColumn Header="清理后内存" Binding="{Binding MemoryAfterBytes}" Width="95"/>
                        <DataGridTextColumn Header="详情" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="用户反馈">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="FbName" Width="160" Margin="0,0,8,0" ToolTip="进程名" Padding="6,4"/>
                        <TextBox x:Name="FbPath" Width="260" Margin="0,0,8,0" ToolTip="可执行文件路径" Padding="6,4"/>
                        <ComboBox x:Name="FbCategory" Width="160" Margin="0,0,8,0"/>
                        <TextBox x:Name="FbNote" Width="200" Margin="0,0,8,0" ToolTip="备注" Padding="6,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FeedbackEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimestampUtc}" Width="160"/>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="130"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding ReportedCategory}" Width="110"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="70"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding UserNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="提交反馈" Click="SubmitFeedback_Click" Style="{StaticResource PrimaryBtn}"/>
                        <CheckBox x:Name="FbKeep" Content="标记需保留" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FbClean" Content="标记可清理" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FbSystem" Content="标记为系统进程" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="内存清理">
                <ScrollViewer Margin="4">
                    <StackPanel>
                        <TextBlock Text="系统内存区域清理（需要管理员权限）" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="选择要清理的内存区域，点击清理按钮执行。" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkCombinedPageList" Content="Combined Page List（合并页列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkModifiedFileCache" Content="Modified File Cache（修改的文件缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkModifiedPageList" Content="Modified Page List（修改的页列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkRegistryCache" Content="Registry Cache（注册表缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkStandbyList" Content="Standby List（备用列表 - 完整）" Margin="0,4"/>
                        <CheckBox x:Name="ChkStandbyListLow" Content="Standby List (Low Priority)（低优先级备用列表）" Margin="0,4"/>
                        <CheckBox x:Name="ChkSystemFileCache" Content="System File Cache（系统文件缓存）" Margin="0,4"/>
                        <CheckBox x:Name="ChkWorkingSet" Content="Working Set（工作集 - 所有进程）" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="清理选中区域" Click="CleanMemoryAreas_Click" Style="{StaticResource DangerBtn}"/>
                            <Button Content="全选" Click="SelectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                            <Button Content="取消全选" Click="DeselectAllAreas_Click" Style="{StaticResource PrimaryBtn}" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="CleanResultText" Text="" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="设置">
                <ScrollViewer Margin="4">
                    <StackPanel>
                        <TextBlock Text="阈值配置" FontWeight="Bold" Margin="0,0,0,4" Foreground="#111827"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="未使用 CPU 阈值 (%)" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetCpu" Width="80" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="未使用空闲分钟数" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetIdle" Width="80" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="刷新间隔 (秒)" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetRefresh" Width="80" Padding="4"/>
                        </StackPanel>
                        <TextBlock Text="联网查询" FontWeight="Bold" Margin="0,10,0,4" Foreground="#111827"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="查询端点 URL" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetEndpoint" Width="400" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="API 密钥" Width="200" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetApiKey" Width="400" Padding="4"/>
                        </StackPanel>
                        <CheckBox x:Name="SetOnlineEnabled" Content="启用联网查询" Margin="0,4"/>
                        <TextBlock Text="保护名单管理" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBlock Text="受保护进程（每行一个）：" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="ProtectedListEditor" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,0,0,8"/>
                        <TextBlock Text="白名单（可清理排除）：" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="WhitelistEditor" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,0,0,8"/>
                        <TextBlock Text="黑名单（优先清理）：" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="BlacklistEditor" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,0,0,8"/>
                        <Button Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource PrimaryBtn}" Margin="0,8,0,0"/>
                        <TextBlock Text="白名单/黑名单保存在 config.json" Margin="0,10,0,0" Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#F9FAFB">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="#374151"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding IsBusy}" Foreground="#9CA3AF"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>