<Application x:Class="MemoryTool.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MemoryTool.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#059669"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RowAltBg" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#1F2937"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E6"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ControlFg" Color="#111827"/>
        <SolidColorBrush x:Key="TrackBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ChipBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="ChipHoverBg" Color="#E2E8F0"/>

        <!-- implicit control styling: without these, check-boxes/text-boxes keep black
             system text on the dark theme (the "font same color as background" bug) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ControlFg}"/>
        </Style>
    </Application.Resources>
</Application>
