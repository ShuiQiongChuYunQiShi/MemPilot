<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MemoryTool</AssemblyName>
    <RootNamespace>MemoryTool</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Title>MemoryTool</Title>
    <Product>MemoryTool - 内存与进程管家</Product>
    <Description>常驻内存与进程管理器：未使用检测、场景模式、腾挪工作流</Description>
    <Company>MemoryTool</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MemoryTool.Core\MemoryTool.Core.csproj" />
  </ItemGroup>
  <Target Name="SignExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <!-- sign both the apphost exe (what users double-click, SmartScreen checks it) and the managed dll -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\sign.ps1&quot; -TargetPath &quot;$(TargetDir)$(TargetName).exe&quot;" ContinueOnError="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\sign.ps1&quot; -TargetPath &quot;$(TargetPath)&quot;" ContinueOnError="true" />
  </Target>
</Project>
