<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MemPilot</RootNamespace>
    <AssemblyName>MemPilot.Core</AssemblyName>
    <!-- 可复现构建：锁文件入库，CI 用 locked-mode（棱镜 stack/dependency） -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- v0.18.0：身份复检的纯逻辑（IsStillSameProcess）需要直接单测 -->
    <InternalsVisibleTo Include="MemPilot.Tests" />
  </ItemGroup>
</Project>
